#:include "../include/common.fypp"
#:set RC_KINDS_TYPES = REAL_KINDS_TYPES + CMPLX_KINDS_TYPES
module TestExpmlib
    ! Fortran Standard Library.
    use stdlib_linalg, only: eye, diag, expm, hermitian
    ! Testdrive
    use testdrive, only: new_unittest, unittest_type, error_type, check
    ! LightKrylov
    use LightKrylov
    use LightKrylov_Constants
    use LightKrylov_Logger
    use LightKrylov_Utils, only : eig, sqrtm
    ! Test Utilities
    use LightKrylov_TestUtils
    use TestUtils

    implicit none (type, external)

    private

    character(len=*), parameter, private :: this_module      = 'LK_TExpmLib'
    character(len=*), parameter, private :: this_module_long = 'LightKrylov_TestExpmLib'

    #:for kind, type in RC_KINDS_TYPES
    public :: collect_expm_${type[0]}$${kind}$_testsuite
    #:endfor

    #:for kind, type in RC_KINDS_TYPES
    public :: collect_sqrtm_${type[0]}$${kind}$_testsuite
    #:endfor

contains

    !--------------------------------------------------------------
    !-----     UNIT TESTS FOR DENSE MATRIX EXPONENTIATION     -----
    !--------------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    subroutine collect_expm_${type[0]}$${kind}$_testsuite(testsuite)
        type(unittest_type), allocatable, intent(out) :: testsuite(:)

        testsuite = [ &
                        new_unittest("Krylov expm invalid inputs", test_kexptA_invalid_inputs_${type[0]}$${kind}$), &
                        new_unittest("Dense expm", test_dense_expm_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm", test_kexptA_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm adjoint", test_kexptA_adjoint_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm zero input", test_kexptA_zero_input_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm invariant subspace", test_kexptA_breakdown_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm stiff (sub-stepping)", test_kexptA_stiff_${type[0]}$${kind}$), &
                        new_unittest("Krylov expm warm start", test_kexptA_warm_start_${type[0]}$${kind}$), &
                        new_unittest("Block Krylov expm", test_block_kexptA_${type[0]}$${kind}$) &
                    ]

        return
    end subroutine collect_expm_${type[0]}$${kind}$_testsuite

    subroutine test_kexptA_invalid_inputs_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, Bblk(:), Cblk(:), X(:)
        ! Sub-stepping options and metadata.
        type(kexpm_${kind}$_opts) :: opts
        type(kexpm_${kind}$_metadata) :: meta
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        integer, parameter :: p = 2
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        integer :: icase
        character(len=256) :: msg

        ! Common initialization.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        allocate(b, c) ; call init_rand(b) ; call c%zero()
        allocate(Bblk(p)) ; call init_rand(Bblk)

        test_loop: do
            !-----     Single vector kexpm     -----

            ! --- Case 1: workspace with fewer than 2 vectors (info = -3) ---
            icase = 1
            allocate(X(1)) ; call zero_basis(X)
            call kexpm(c, A, b, tau, rtol_${kind}$, info, X=X)
            call check(error, info == -3)
            if (allocated(error)) exit test_loop

            ! --- Case 2: kdim < 1 (info = -4) ---
            icase = 2
            call kexpm(c, A, b, tau, rtol_${kind}$, info, kdim=0)
            call check(error, info == -4)
            if (allocated(error)) exit test_loop

            ! --- Case 3: negative tolerance (info = -5) ---
            icase = 3
            call kexpm(c, A, b, tau, -1.0_${kind}$, info)
            call check(error, info == -5)
            if (allocated(error)) exit test_loop

            !-----     Block kexpm     -----

            ! --- Case 4: size(C) /= size(B) (info = -6) ---
            icase = 4
            allocate(Cblk(p+1)) ; call zero_basis(Cblk)
            call kexpm(Cblk, A, Bblk, tau, rtol_${kind}$, info)
            call check(error, info == -6)
            if (allocated(error)) exit test_loop

            ! --- Case 5: empty block (info = -6) ---
            icase = 5
            block
                type(vector_${type[0]}$${kind}$), allocatable :: B0(:), C0(:)
                allocate(B0(0), C0(0))
                call kexpm(C0, A, B0, tau, rtol_${kind}$, info)
            end block
            call check(error, info == -6)
            if (allocated(error)) exit test_loop

            ! --- Case 6: workspace size not a multiple of the block size (info = -3) ---
            icase = 6
            deallocate(Cblk, X) ; allocate(Cblk(p), X(2*p+1)) ; call zero_basis(Cblk) ; call zero_basis(X)
            call kexpm(Cblk, A, Bblk, tau, rtol_${kind}$, info, X=X)
            call check(error, info == -3)
            if (allocated(error)) exit test_loop

            ! --- Case 7: workspace with fewer than 2*p vectors (info = -3) ---
            icase = 7
            deallocate(X) ; allocate(X(p)) ; call zero_basis(X)
            call kexpm(Cblk, A, Bblk, tau, rtol_${kind}$, info, X=X)
            call check(error, info == -3)
            if (allocated(error)) exit test_loop

            ! --- Case 8: kdim < 1 (info = -4) ---
            icase = 8
            call kexpm(Cblk, A, Bblk, tau, rtol_${kind}$, info, kdim=0)
            call check(error, info == -4)
            if (allocated(error)) exit test_loop

            ! --- Case 9: negative tolerance (info = -5) ---
            icase = 9
            call kexpm(Cblk, A, Bblk, tau, -1.0_${kind}$, info)
            call check(error, info == -5)
            if (allocated(error)) exit test_loop

            !-----     Sub-stepped kexpm_substep     -----

            ! --- Case 10: opts%kdim < 1 (info = -4) ---
            icase = 10
            opts = kexpm_${kind}$_opts(kdim=0)
            call kexpm_substep(c, A, b, tau, rtol_${kind}$, info, options=opts)
            call check(error, info == -4)
            if (allocated(error)) exit test_loop

            ! --- Case 11: negative tolerance (info = -5) ---
            icase = 11
            call kexpm_substep(c, A, b, tau, -1.0_${kind}$, info)
            call check(error, info == -5)
            if (allocated(error)) exit test_loop

            ! --- Case 12: opts%max_rejections < 1 (info = -7) ---
            icase = 12
            opts = kexpm_${kind}$_opts(max_rejections=0)
            call kexpm_substep(c, A, b, tau, rtol_${kind}$, info, options=opts, meta=meta)
            call check(error, info == -7)
            if (allocated(error)) exit test_loop

            ! --- Case 13: opts%max_substeps < 1 (info = -7), metadata left untouched ---
            icase = 13
            opts = kexpm_${kind}$_opts(max_substeps=0)
            call kexpm_substep(c, A, b, tau, rtol_${kind}$, info, options=opts, meta=meta)
            call check(error, info == -7 .and. meta%n_calls == 0 .and. .not. meta%learned)
            exit test_loop
        end do test_loop
        write(msg, '(A,I0)') 'last case: ', icase
        call check_test(error, 'test_kexptA_invalid_inputs_${type[0]}$${kind}$', &
                              & info='Invalid input parameters', eq='', context=msg)

        return
    end subroutine test_kexptA_invalid_inputs_${type[0]}$${kind}$

    subroutine test_dense_expm_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Problem dimension.
        integer, parameter :: n = 5, m = 6
        ! Test matrix.
        ${type}$ :: A(n, n), E(n, n), Eref(n, n)
        ! Miscellaneous.
        integer :: i, j
        real(${kind}$) :: err
        character(len=256) :: msg

        ! Initialize nilpotent matrix (the exponential is a finite series).
        A = 0.0_${kind}$
        do i = 1, n-1
            A(i, i+1) = m*1.0_${kind}$
        enddo

        ! Reference with analytical exponential: Eref(i, i+j) = m**j / j!.
        Eref = eye(n, mold=1.0_${kind}$)
        do i = 1, n-1
            do j = 1, n-i
                Eref(i, i+j) = Eref(i, i+j-1)*m/j
            enddo
        enddo

        ! Compute matrix exponential.
        E = expm(A)

        ! Check result.
        err = maxval(abs(E-Eref))
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_dense_expm_${type[0]}$${kind}$', &
                              & info='Nilpotent matrix', eq='expm(A) = Eref', context=msg)

        return
    end subroutine test_dense_expm_${type[0]}$${kind}$

    subroutine test_kexptA_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, cref
        ! Krylov subspace (user-supplied workspace).
        integer, parameter :: kdim = 64
        type(vector_${type[0]}$${kind}$), allocatable :: X(:)
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        real(${kind}$) :: err
        character(len=256) :: msg

        ! Initialize linear operator and vectors.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        allocate(b, c, cref) ; call init_rand(b) ; call c%zero()
        allocate(X(kdim+1)) ; call zero_basis(X)

        ! Reference: dense computation.
        cref%data = matmul(expm(tau*A%data), b%data)

        ! kexpm with internal workspace.
        call kexpm(c, A, b, tau, rtol_${kind}$, info, kdim=kdim)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_${type[0]}$${kind}$', &
                              & info='kexpm', eq='c = expm(tau A) @ b', context=msg)

        ! krylov_exptA (adaptive sub-stepping).
        call krylov_exptA(c, A, b, tau, info)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_${type[0]}$${kind}$', &
                              & info='krylov_exptA', eq='c = expm(tau A) @ b', context=msg)

        ! kexpm with user-supplied workspace.
        call kexpm(c, A, b, tau, rtol_${kind}$, info, X=X)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_${type[0]}$${kind}$', &
                              & info='kexpm, workspace', eq='c = expm(tau A) @ b', context=msg)

        ! Re-used (non-zeroed) workspace with kdim smaller than the workspace.
        call kexpm(c, A, b, tau, rtol_${kind}$, info, kdim=kdim/2, X=X)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. info <= kdim/2 + 1 .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_${type[0]}$${kind}$', &
                              & info='kexpm, workspace + kdim', eq='c = expm(tau A) @ b', context=msg)

        return
    end subroutine test_kexptA_${type[0]}$${kind}$

    subroutine test_kexptA_adjoint_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, cref
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        real(${kind}$) :: err
        character(len=256) :: msg

        ! Initialize linear operator and vectors.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        allocate(b, c, cref) ; call init_rand(b) ; call c%zero()

        ! Reference: dense computation with the adjoint operator.
        cref%data = matmul(expm(tau*hermitian(A%data)), b%data)

        ! kexpm.
        call kexpm(c, A, b, tau, rtol_${kind}$, info, trans=.true.)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_adjoint_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_adjoint_${type[0]}$${kind}$', &
                              & info='kexpm', eq='c = expm(tau A.H) @ b', context=msg)

        ! krylov_exptA.
        call krylov_exptA(c, A, b, tau, info, trans=.true.)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_adjoint_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_adjoint_${type[0]}$${kind}$', &
                              & info='krylov_exptA', eq='c = expm(tau A.H) @ b', context=msg)

        return
    end subroutine test_kexptA_adjoint_${type[0]}$${kind}$

    subroutine test_kexptA_zero_input_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        integer, parameter :: p = 2
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, Bblk(:), Cblk(:)
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        real(${kind}$) :: err
        integer :: i
        character(len=256) :: msg

        ! Initialize linear operator, zero inputs and non-zero outputs.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        allocate(b, c) ; call b%zero()
        allocate(Bblk(p), Cblk(p)) ; call zero_basis(Bblk)

        do
            ! kexpm.
            call c%rand()
            call kexpm(c, A, b, tau, rtol_${kind}$, info)
            err = c%norm()
            call check(error, info > 0 .and. err == 0.0_${kind}$)
            if (allocated(error)) exit

            ! krylov_exptA.
            call c%rand()
            call krylov_exptA(c, A, b, tau, info)
            err = c%norm()
            call check(error, info > 0 .and. err == 0.0_${kind}$)
            if (allocated(error)) exit

            ! Block kexpm.
            call rand_basis(Cblk)
            call kexpm(Cblk, A, Bblk, tau, rtol_${kind}$, info)
            err = 0.0_${kind}$
            do i = 1, p
                err = err + Cblk(i)%norm()
            enddo
            call check(error, info > 0 .and. err == 0.0_${kind}$)
            exit
        enddo
        call get_err_str(msg, "norm: ", err)
        call check_test(error, 'test_kexptA_zero_input_${type[0]}$${kind}$', &
                              & info='Zero input', eq='expm(tau A) @ 0 = 0', context=msg)

        return
    end subroutine test_kexptA_zero_input_${type[0]}$${kind}$

    subroutine test_kexptA_breakdown_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, cref
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        integer, parameter :: k_inv = 10
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        real(${kind}$) :: err
        character(len=256) :: msg

        ! Create block lower triangular matrix: span(e_1, ..., e_k_inv) is invariant.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        A%data(k_inv+1:, :k_inv) = zero_${type[0]}$${kind}$

        ! Input vector confined to the invariant subspace.
        allocate(b, c, cref) ; call init_rand(b) ; call c%zero()
        b%data(k_inv+1:) = zero_${type[0]}$${kind}$

        ! Reference: dense computation.
        cref%data = matmul(expm(tau*A%data), b%data)

        ! kexpm with tol = 0: convergence is only possible through the Arnoldi breakdown,
        ! which must happen after exactly k_inv steps (the approximation is then exact).
        call kexpm(c, A, b, tau, 0.0_${kind}$, info)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_breakdown_${type[0]}$${kind}$')
        call check(error, info == k_inv)
        call check_test(error, 'test_kexptA_breakdown_${type[0]}$${kind}$', &
                              & info='Subspace Dim', eq='info == k_inv', context='Invariant detection')

        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_breakdown_${type[0]}$${kind}$', &
                              & info='Invariant Property', eq='c = expm(tau A) @ b', context=msg)

        ! krylov_exptA: a single sub-step, never more than k_inv matrix-vector products.
        call krylov_exptA(c, A, b, tau, info)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_breakdown_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info <= k_inv .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_breakdown_${type[0]}$${kind}$', &
                              & info='krylov_exptA', eq='<= k_inv matvecs, c = expm(tau A) @ b', context=msg)

        return
    end subroutine test_kexptA_breakdown_${type[0]}$${kind}$

    subroutine test_kexptA_stiff_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, cref
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        real(${kind}$), parameter :: tau = 1.0_${kind}$, s = 30.0_${kind}$
        real(${kind}$) :: err
        character(len=256) :: msg

        ! Stable random operator with || tau A || ~ 60: far beyond what a single
        ! 30-vector Krylov basis can resolve.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        A%data = s*A%data/sqrt(real(test_size, ${kind}$)) - s*eye(test_size, mold=1.0_${kind}$)
        allocate(b, c, cref) ; call init_rand(b) ; call c%zero()

        ! Reference: dense computation.
        cref%data = matmul(expm(tau*A%data), b%data)

        ! krylov_exptA must converge thanks to the adaptive sub-stepping (> 30 matvecs).
        call krylov_exptA(c, A, b, tau, info)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_stiff_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 30 .and. err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_stiff_${type[0]}$${kind}$', &
                              & info='Sub-stepping', eq='c = expm(tau A) @ b', context=msg)

        return
    end subroutine test_kexptA_stiff_${type[0]}$${kind}$

    subroutine test_kexptA_warm_start_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        type(vector_${type[0]}$${kind}$), allocatable :: b, c, cref
        ! Sub-stepping options and metadata.
        type(kexpm_${kind}$_opts) :: opts
        type(kexpm_${kind}$_metadata) :: meta
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        integer, parameter :: ncalls = 10
        real(${kind}$), parameter :: tau = 1.0_${kind}$, s = 30.0_${kind}$
        ${type}$, allocatable :: E(:, :)
        real(${kind}$) :: err, tol
        integer :: icall, cold, last
        character(len=256) :: msg

        ! Stiff stable random operator.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        A%data = s*A%data/sqrt(real(test_size, ${kind}$)) - s*eye(test_size, mold=1.0_${kind}$)
        E = expm(tau*A%data)
        allocate(b, c, cref) ; call c%zero()

        ! Repeated calls with a persistent metadata object and new right-hand sides.
        err = 0.0_${kind}$
        do icall = 1, ncalls
            call init_rand(b) ; cref%data = matmul(E, b%data) ; tol = atol_${kind}$*b%norm()
            call kexpm_substep(c, A, b, tau, tol, info, meta=meta)
            call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_warm_start_${type[0]}$${kind}$')
            if (icall == 1) cold = info
            last = info
            call c%sub(cref) ; err = max(err, c%norm() / cref%norm())
        enddo
        write(msg, '(A,E9.2,A,I0,A,I0,A,I0)') 'max err: ', err, ', cold: ', cold, ', last: ', last, ', nsub: ', meta%nsub
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_kexptA_warm_start_${type[0]}$${kind}$', &
                              & info='Accuracy', eq='c = expm(tau A) @ b', context=msg)

        ! Settings learned, frozen, and not more expensive than the cold call (up to the
        ! call-to-call variation of the adaptive cost with the right-hand side).
        call check(error, meta%learned .and. meta%frozen .and. meta%n_calls == ncalls &
                        & .and. last <= cold + max(2, cold/10))
        call check_test(error, 'test_kexptA_warm_start_${type[0]}$${kind}$', &
                              & info='Learned settings', eq='frozen, cost <= cold cost', context=msg)

        ! reset() keeps the learned settings, forget() clears them.
        do
            call meta%reset()
            call check(error, meta%learned .and. meta%n_calls == 0 .and. meta%n_matvec == 0)
            if (allocated(error)) exit
            call meta%forget()
            call check(error, .not. meta%learned .and. meta%nsub == 0)
            exit
        enddo
        call check_test(error, 'test_kexptA_warm_start_${type[0]}$${kind}$', &
                              & info='reset / forget', eq='reset keeps, forget clears', context='')

        ! tune = .false. : the sub-step count of the cold call is kept.
        opts = kexpm_${kind}$_opts(tune=.false.)
        call init_rand(b) ; cref%data = matmul(E, b%data) ; tol = atol_${kind}$*b%norm()
        call kexpm_substep(c, A, b, tau, tol, info, options=opts, meta=meta)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_warm_start_${type[0]}$${kind}$')
        call kexpm_substep(c, A, b, tau, tol, info, options=opts, meta=meta)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_warm_start_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        write(msg, '(A,E9.2,A,I0,A,I0)') 'max err: ', err, ', nsub: ', meta%nsub, ', nsub0: ', meta%nsub0
        call check(error, err < rtol_${kind}$ .and. meta%frozen .and. meta%nsub == meta%nsub0)
        call check_test(error, 'test_kexptA_warm_start_${type[0]}$${kind}$', &
                              & info='No tuning', eq='nsub == nsub0', context=msg)

        ! A different horizon invalidates the learned settings.
        cref%data = matmul(expm(0.5_${kind}$*tau*A%data), b%data)
        call kexpm_substep(c, A, b, 0.5_${kind}$*tau, tol, info, meta=meta)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_kexptA_warm_start_${type[0]}$${kind}$')
        call c%sub(cref) ; err = c%norm() / cref%norm()
        write(msg, '(A,E9.2,A,E9.2)') 'max err: ', err, ', tau_learned: ', meta%tau_learned
        call check(error, err < rtol_${kind}$ .and. abs(meta%tau_learned - 0.5_${kind}$*tau) <= epsilon(tau))
        call check_test(error, 'test_kexptA_warm_start_${type[0]}$${kind}$', &
                              & info='New horizon', eq='settings re-learned', context=msg)

        return
    end subroutine test_kexptA_warm_start_${type[0]}$${kind}$

    subroutine test_block_kexptA_${type[0]}$${kind}$(error)
        ! Error type to be returned.
        type(error_type), allocatable, intent(out) :: error
        ! Test linear operator.
        type(linop_${type[0]}$${kind}$), allocatable :: A
        ! Test vectors.
        integer, parameter :: p = 3
        type(vector_${type[0]}$${kind}$), allocatable :: B(:), C(:)
        ! Krylov subspace (user-supplied workspace).
        integer, parameter :: kdim = 15
        type(vector_${type[0]}$${kind}$), allocatable :: X(:)
        ! Information flag.
        integer :: info
        ! Miscellaneous.
        real(${kind}$), parameter :: tau = 0.1_${kind}$
        ${type}$, allocatable :: Bdata(:, :), Cdata(:, :), Cref(:, :)
        real(${kind}$) :: err
        integer :: i
        character(len=256) :: msg

        ! Initialize linear operator and input block.
        A = linop_${type[0]}$${kind}$() ; call init_rand(A)
        allocate(B(p), C(p), X(p*(kdim+1))) ; call init_rand(B) ; call zero_basis(C) ; call zero_basis(X)
        allocate(Bdata(test_size, p), Cdata(test_size, p)) ; call get_data(Bdata, B)

        ! Reference: dense computation.
        Cref = matmul(expm(tau*A%data), Bdata)

        ! Column-by-column kexpm.
        do i = 1, p
            call kexpm(C(i), A, B(i), tau, rtol_${kind}$, info, kdim=kdim)
            call check_info(info, 'kexpm', module=this_module_long, procedure='test_block_kexptA_${type[0]}$${kind}$')
        enddo
        call get_data(Cdata, C)
        err = norm2(abs(Cdata - Cref)) / norm2(abs(Cref))
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_block_kexptA_${type[0]}$${kind}$', &
                              & info='Column-wise', eq='C = expm(tau A) @ B', context=msg)

        ! Block kexpm.
        call kexpm(C, A, B, tau, rtol_${kind}$, info, kdim=kdim)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_block_kexptA_${type[0]}$${kind}$')
        call get_data(Cdata, C)
        err = norm2(abs(Cdata - Cref)) / norm2(abs(Cref))
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. info <= p*(kdim+1) .and. err < rtol_${kind}$)
        call check_test(error, 'test_block_kexptA_${type[0]}$${kind}$', &
                              & info='Block', eq='C = expm(tau A) @ B', context=msg)

        ! Block kexpm with user-supplied workspace.
        call kexpm(C, A, B, tau, rtol_${kind}$, info, X=X)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_block_kexptA_${type[0]}$${kind}$')
        call get_data(Cdata, C)
        err = norm2(abs(Cdata - Cref)) / norm2(abs(Cref))
        call get_err_str(msg, "max err: ", err)
        call check(error, info > 0 .and. err < rtol_${kind}$)
        call check_test(error, 'test_block_kexptA_${type[0]}$${kind}$', &
                              & info='Block, workspace', eq='C = expm(tau A) @ B', context=msg)

        block
        integer, parameter :: pinv = 2, k_inv = 2*pinv
        type(vector_${type[0]}$${kind}$), allocatable :: B2(:), C2(:)
        ${type}$, allocatable :: B2data(:, :), C2data(:, :), C2ref(:, :)

        ! Create block lower triangular matrix: span(e_1, ..., e_k_inv) is invariant.
        call init_rand(A)
        A%data(k_inv+1:, :k_inv) = zero_${type[0]}$${kind}$

        ! Input block confined to the invariant subspace.
        allocate(B2(pinv), C2(pinv)) ; call init_rand(B2) ; call zero_basis(C2)
        do i = 1, pinv
            B2(i)%data(k_inv+1:) = zero_${type[0]}$${kind}$
        enddo
        allocate(B2data(test_size, pinv), C2data(test_size, pinv)) ; call get_data(B2data, B2)
        C2ref = matmul(expm(tau*A%data), B2data)

        ! tol = 0: block Arnoldi must break down after k_inv/pinv block steps (exact approximation).
        call kexpm(C2, A, B2, tau, 0.0_${kind}$, info)
        call check_info(info, 'kexpm', module=this_module_long, procedure='test_block_kexptA_${type[0]}$${kind}$')
        call check(error, info == k_inv)
        call check_test(error, 'test_block_kexptA_${type[0]}$${kind}$', &
                              & info='Subspace Dim', eq='info == k_inv', context='Invariant detection')

        call get_data(C2data, C2)
        err = norm2(abs(C2data - C2ref)) / norm2(abs(C2ref))
        call get_err_str(msg, "max err: ", err)
        call check(error, err < rtol_${kind}$)
        call check_test(error, 'test_block_kexptA_${type[0]}$${kind}$', &
                              & info='Invariant Property', eq='C = expm(tau A) @ B', context=msg)
        end block

        return
    end subroutine test_block_kexptA_${type[0]}$${kind}$

    #:endfor
    !-----------------------------------------------------------
    !-----     UNIT TESTS FOR DENSE MATRIX SQUARE ROOT     -----
    !-----------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    subroutine collect_sqrtm_${type[0]}$${kind}$_testsuite(testsuite)
        type(unittest_type), allocatable, intent(out) :: testsuite(:)

        testsuite = [ &
                        new_unittest("Dense sqrtm for positive definite matrices.", test_dense_sqrtm_pos_def_${type[0]}$${kind}$), &
                        new_unittest("Dense sqrtm for positive semi-definite matrices.", test_dense_sqrtm_pos_semi_def_${type[0]}$${kind}$) &
                    ]

        return
    end subroutine collect_sqrtm_${type[0]}$${kind}$_testsuite

    subroutine test_dense_sqrtm_pos_def_${type[0]}$${kind}$(error)
       !> This function tests the matrix version of the sqrt function for the case of
       ! a symmetric/hermitian positive definite matrix
    
       !> Error type to be returned.
       type(error_type), allocatable, intent(out) :: error
       !> Problem dimension.
       integer, parameter :: n = 5
       !> Test matrix.
       ${type}$ :: A(n, n)
       ${type}$ :: sqrtmA(n, n)
       complex(${kind}$) :: lambda(n)
       real(${kind}$) :: err
       integer :: i, info
       character(len=256) :: msg
    
       ! --> Initialize matrix.
       #:if type[0] == "r"
       call random_number(A)
       #:else
       call random_number(A%re)
       call random_number(A%im)
       #:endif
       ! make symmetric/hermitian positive definite
       #:if type[0] == "r"
       A = 0.5_${kind}$*(A + transpose(A))
       #:else
       A = 0.5_${kind}$*(A + conjg(transpose(A)))
       #:endif
       call eig(A, sqrtmA, lambda)
       do i = 1,n
          lambda(i) = abs(lambda(i)) + 0.1_${kind}$
       end do
       ! reconstruct matrix
       #:if type[0] == "r"
       A = matmul(sqrtmA, matmul(diag(abs(lambda)), transpose(sqrtmA)))
       #:else
       A = matmul(sqrtmA, matmul(diag(abs(lambda)), conjg(transpose(sqrtmA))))
       #:endif
     
       ! compute matrix square root
       call sqrtm(A, sqrtmA, info)
       call check_info(info, 'sqrtm', module=this_module_long, procedure='test_dense_sqrtm_pos_def_${type[0]}$${kind}$')
    
       #:if type[0] == "r"
       err = maxval(abs(matmul(sqrtmA, sqrtmA) - A))
       call get_err_str(msg, "max err: ", err)
       call check(error, err < rtol_${kind}$)
       #:else
       err =  maxval(abs(matmul(sqrtmA, sqrtmA) - A))
       call get_err_str(msg, "max err: ", err)
       call check(error, err < rtol_${kind}$)
       #:endif
       call check_test(error, 'test_dense_sqrtm_pos_def_${type[0]}$${kind}$', eq='sqrt(A)**2 = A', context=msg)
    
       return
    end subroutine test_dense_sqrtm_pos_def_${type[0]}$${kind}$
    
    subroutine test_dense_sqrtm_pos_semi_def_${type[0]}$${kind}$(error)
       !> This function tests the matrix version of the sqrt function for the case 
       ! of a symmetric semi-definite matrix
    
       !> Error type to be returned.
       type(error_type), allocatable, intent(out) :: error
       !> Problem dimension.
       integer, parameter :: n = 25
       !> Test matrix.
       ${type}$ :: A(n, n)
       ${type}$ :: sqrtmA(n, n)
       complex(${kind}$) :: lambda(n)
       real(${kind}$) :: err
       integer :: i, info
       character(len=256) :: msg
    
       ! --> Initialize matrix.
       #:if type[0] == "r"
       call random_number(A)
       #:else
       call random_number(A%re)
       call random_number(A%im)
       #:endif
       ! make symmetric/hermitian positive semi-definite
       #:if type[0] == "r"
       A = 0.5_${kind}$*(A + transpose(A))
       #:else
       A = 0.5_${kind}$*(A + conjg(transpose(A)))
       #:endif
       call eig(A, sqrtmA, lambda)
       do i = 1,n-1
          lambda(i) = abs(lambda(i)) + 0.1_${kind}$
       end do
       lambda(n) = zero_r${kind}$
       ! reconstruct matrix
       #:if type[0] == "r"
       A = matmul(sqrtmA, matmul(diag(abs(lambda)), transpose(sqrtmA)))
       #:else
       A = matmul(sqrtmA, matmul(diag(abs(lambda)), conjg(transpose(sqrtmA))))
       #:endif
    
       ! compute matrix square root
       call sqrtm(A, sqrtmA, info)
       call check_info(info, 'sqrtm', module=this_module_long, procedure='test_dense_sqrtm_pos_semi_def_${type[0]}$${kind}$')
    
       #:if type[0] == "r"
       err = maxval(abs(matmul(sqrtmA, sqrtmA) - A))
       call get_err_str(msg, "max err: ", err)
       call check(error, err < rtol_${kind}$)
       #:else
       err = maxval(abs(matmul(sqrtmA, sqrtmA) - A))
       call get_err_str(msg, "max err: ", err)
       call check(error, err < rtol_${kind}$)
       #:endif
       call check_test(error, 'test_dense_sqrtm_pos_semi_def_${type[0]}$${kind}$', eq='sqrt(A)**2 = A', context=trim(msg))
    
       return
    end subroutine test_dense_sqrtm_pos_semi_def_${type[0]}$${kind}$

    #:endfor

end module TestExpmLib