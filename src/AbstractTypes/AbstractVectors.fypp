#:include "../../include/common.fypp"
#:set RC_KINDS_TYPES = REAL_KINDS_TYPES + CMPLX_KINDS_TYPES
module LightKrylov_AbstractVectors
    !! This module provides the base class `abstract_vector` from which all Krylov vectors
    !! needs to be derived. To use `LightKrylov`, you need to extend one of the
    !! followings:
    !!
    !! - `abstract_vector_rsp`  :   Real-valued vector with single precision arithmetic.
    !! - `abstract_vector_rdp`  :   Real-valued vector with double precision arithmetic.
    !! - `abstract_vector_csp`  :   Complex-valued vector with single precision arithmetic.
    !! - `abstract_vector_cdp`  :   Complex-valued vector with double precision arithmetic.
    !!
    !! To extend either of these abstract types, you need to provide an associated implementation
    !! for the following type-bound procedures:
    !!
    !! - `zero(self)`                   :   A subroutine zeroing-out the vector.
    !! - `rand(self, ifnorm)`           :   A subroutine creating a random vector, possibily normalized to have unit-norm (`ifnorm = .true.`).
    !! - `scal(self, alpha)`            :   A subroutine computing *in-place* the scalar multiplication \( \mathbf{x} \leftarrow \alpha \mathbf{x} \).
    !! - `axpby(alpha, vec, beta, self)`:   A subroutine computing *in-place* the product \( \mathbf{y} \leftarrow \alpha \mathbf{x} + \beta \mathbf{y} \).
    !! - `dot(self, vec)`               :   A function computing the inner product \( \alpha = \langle \mathbf{x} \vert \mathbf{y} \rangle \).
    !! - `get_size(self)`               :   A function returning the dimension \( n \) of the vector \( \mathbf{x} \).
    !! - `init_like(self, mold)`        :   A subroutine to initialize the vector after allocation to match the size and structure of the mold.
    !!
    !! Once these type-bound procedures have been implemented by the user, they will automatically
    !! be used to define:
    !!
    !! - vector addition    :   `add(self, vec) = axpby(1, vec, 1, self)`
    !! - vector subtraction :   `sub(self, vec) = axpby(-1, vec, 1, self)`
    !! - vector norm        :   `norm(self)     = sqrt(self%dot(self))`
    !!
    !! ### Lifecycle hooks
    !!
    !! `LightKrylov` never owns the memory of a user-provided vector: it never allocates or
    !! deallocates it, and only reaches its storage through the overridable hooks below, which
    !! all act on objects that already exist. On user-provided outputs and bases, the library
    !! calls `init_like` (a no-op when already conformant), `assign` and `swap`. It never calls
    !! `free` on a vector it did not create itself.
    !!
    !! - `init_like(self, mold)`  :   (deferred) Shape `self` like `mold`.
    !! - `assign(self, from)`     :   Copy assignment \( \mathbf{x} \leftarrow \mathbf{y} \). Storage of `self`
    !!                                 is reused. Default: `init_like` followed by `axpby(1, from, 0)`.
    !! - `swap(self, other)`      :   Exchange the full state of two vectors; both remain valid. Default:
    !!                                 three `assign` through a temporary vector. Override it to exchange
    !!                                 storage instead (e.g. `move_alloc`) for a copy-free swap.
    !! - `free(self)`             :   Release the storage held by the vector. Only ever called by the owner of the vector.
    !!                                 Types holding allocatable components should override it to deallocate them,
    !!                                 so that memory is returned immediately rather than when the object goes out of scope.
    !!
    !! `assign` and `swap` are declared on the root `abstract_vector` and take `class(abstract_vector)`
    !! arguments, so that overrides in concrete types use `select type` on the second argument.
    !!
    !! Any temporary vector created by the library is released explicitly, with `free` followed by
    !! `deallocate`, rather than relying on automatic deallocation at the end of its scope.
    !!
    !! This module also provides the following utility subroutines:
    !!
    !! - `innerprod(X, Y)`                  : Function computing the product \(\mathbf{X}^H \mathbf{y} \) between a Krylov basis `X` and a Krylov vector  (resp. basis) `Y`.
    !! - `linear_combination(Y, X, V)`      : Subroutine computing the linear combination \( \mathbf{y}_j = \sum_{i=1}^n \mathbf{x}_i v_{ij} \)
    !!                                        in-place into the caller-provided `Y`.
    !! - `axpby_basis(alpha, X, beta, Y)`   : In-place computation of \( \mathbf{Y} \leftarrow \alpha \mathbf{X} + \beta \mathbf{Y} \) where `X` and `Y` are arrays of `abstract_vector`.
    !! - `zero_basis(X)`                    : Zero-out a collection of `abstract_vectors`.
    !! - `copy(out, from)`                  : Copy a vector (or, elementally, a collection of vectors) through `assign`. `out` must be pre-allocated.
    !! - `init_like_basis(out, mold)`       : Initialize size and structure of a collection of `abstract_vectors` based on mold.
    !! - `free_basis(X)        `            : Free the memory of a collection of `abstract_vectors`.
    !! - `rand_basis(X, ifnorm)`            : Create a collection of random `abstract_vectors`. If `ifnorm = .true.`, the vectors are normalized to have unit-norm.
    !! @warning
    !! The resulting vectors do not form an orthonormal basis. For this purpose use the utility function `initialize_random_orthonormal_basis`.
    !! @endwarning

    use stdlib_optval, only: optval
    use stdlib_linalg_blas, only: scal, axpy, dot, dotc
    use LightKrylov_Constants
    use LightKrylov_Utils
    use LightKrylov_Logger
    implicit none(type, external)
    private

    character(len=*), parameter :: this_module      = 'LK_Vectors'
    character(len=*), parameter :: this_module_long = 'Lightkrylov_AbstractVectors'

    public :: innerprod, Gram
    public :: linear_combination
    public :: axpby_basis
    public :: zero_basis
    public :: copy
    public :: rand_basis
    public :: init_like_basis
    public :: free_basis
    public :: prepare_workspace
    public :: verify_vector_axioms

    interface innerprod
        !!  Compute the inner product vector \( \mathbf{v} = \mathbf{X}^H \mathbf{y} \) or matrix
        !!  \( \mathbf{M} = \mathbf{X}^H \mathbf{Y} \).
        !!
        !!  ### Description
        !!
        !!  This interface provides methods for computing the inner products between a basis
        !!  of `real` or `complex` vectors \( \mathbf{X} \) and a single vector
        !!  \( \mathbf{y} \) or another basis \( \mathbf{Y} \). Depending on the case, it
        !!  returns a one-dimensional array \( \mathbf{v} \) or a two-dimensional array
        !!  \( \mathbf{M} \) with the same type as \( \mathbf{X} \).
        !!
        !!  ### Example
        !!
        !!  The example below assumes that you have already extended the `abstract_vector_rdp`
        !!  class to define your own `my_real_vector` type.
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      type(my_real_vector)                :: y
        !!      real(dp), dimension(:), allocatable :: v
        !!
        !!      ! ... Part of your code where you initialize everything ...
        !!
        !!      v = innerprod(X, y)
        !!
        !!      ! ... Rest of your code ...
        !!  ```
        !!
        !!  Similarly, for computing the matrix of inner products between two bases
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      type(my_real_vector), dimension(10) :: Y
        !!      real(dp), dimension(:, :), allocatable :: M
        !!
        !!      ! ... Part of your code where you initialize everything ...
        !!
        !!      M = innerprod(X, Y)
        !!
        !!      ! ... Rest of your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure innerprod_vector_${type[0]}$${kind}$
        module procedure innerprod_matrix_${type[0]}$${kind}$
        #:endfor
    end interface

    interface Gram
        !!  Compute the Gram matrix \( \mathbf{G} = \mathbf{X}^H \mathbf{X} \).
        !!
        !!  ### Description
        !!
        !!  This interface provides methods for computing the Gram matrix associated to a basis of
        !!  `abstract_vector` \( \mathbf{X} \).
        !!
        !!  ### Example
        !!
        !!  The example below assumes that you have already extended the `abstract_vector_rdp`
        !!  class to define your own `my_real_vector` type.
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      real(dp), dimension(:, :), allocatable :: G
        !!
        !!      ! ... Part of your code where you initialize everything ...
        !!
        !!      G = Gram(X)
        !!
        !!      ! ... Rest of your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure gram_matrix_${type[0]}$${kind}$
        #:endfor
    end interface

    interface linear_combination
        !!  Given a set of extended `abstract_vectors` and coefficients, return the corresponding
        !!  linear combinations.
        !!
        !!  ### Description
        !!
        !!  This interface provides methods for computing linear combinations of a set of
        !!  `abstract_vectors`. Depending on its input, it either computes
        !!
        !!  \[
        !!      \mathbf{y} = \sum_{i=1}^n \alpha_i \mathbf{x}_i,
        !!  \]
        !!
        !!  i.e. a single vector, or
        !!
        !!  \[
        !!      \mathbf{y}_j = \sum_{i=1}^n \alpha_{ij} \mathbf{x}_i,
        !!  \]
        !!
        !!  i.e. a set of vectors of the same type as \( \mathbf{X} \).
        !!
        !!  The output is computed **in-place**: `y` (resp. `Y`) must be allocated by the caller,
        !!  with `size(Y) == size(B, 2)`. It is shaped like `X(1)` through `init_like` (a no-op if
        !!  already conformant) and its previous content is overwritten. `y` must not alias any
        !!  element of `X`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      real(dp), dimension(10, 3)          :: B
        !!      type(my_real_vector), dimension(3)  :: Y
        !!
        !!      ! ... Whatever your code is doing ...
        !!
        !!      call linear_combination(Y, X, B)
        !!
        !!      ! ... Rest of your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure linear_combination_vector_${type[0]}$${kind}$
        module procedure linear_combination_matrix_${type[0]}$${kind}$
        #:endfor
    end interface

    interface axpby_basis
        !!  In-place addition of two arrays of extended `abstract_vector`.
        !!
        !!  ### Description
        !!
        !!  This interface provides methods to add in-place two arrays of
        !!  extended `abstract_vector`, i.e.
        !!
        !!  \[
        !!      \mathbf{Y}_i \leftarrow \alpha \mathbf{X}_i + \beta \mathbf{Y}_i.
        !!  \]
        !!
        !!  No out-of-place alternative is currently available in `LightKrylov`.
        !!  If you do need an out-of-place version, you can combine `axpby_basis`
        !!  with `copy`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      type(my_real_vector), dimension(10) :: Y
        !!      real(dp), dimension(10)             :: alpha, beta
        !!
        !!      ! ... Whatever your code is doing ...
        !!
        !!      call axpby_basis(alpha, X, beta, Y)
        !!
        !!      ! ... Rest of your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure axpby_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface zero_basis
        !!  This interface provides methods to zero-out a collection of `abstract_vector` `X`.
        !!  It is a simple wrapper around `X(i)%zero()`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!
        !!      ! ... Your code ...
        !!
        !!      call zero_basis(X)
        !!
        !!      ! ... Your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure zero_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface copy
        !!  This interface provides methods to copy an array `X` of `abstract_vector` into
        !!  another array `Y`. Note that `Y` needs to be pre-allocated.
        !!  It is an elemental wrapper around `Y(i)%assign(X(i))`, so that it uses the
        !!  copy-assignment hook of the concrete type (whose default runs `init_like` to make
        !!  `Y(i)` conformant with `X(i)`).
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      type(my_real_vector), dimension(10) :: Y
        !!
        !!      ! ... Your code ...
        !!
        !!      call copy(Y, X)
        !!
        !!      ! ... Your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure copy_vector_${type[0]}$${kind}$
        ! module procedure copy_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface rand_basis
        !!  This interface provides methods to create an array `X` of random `abstract_vector`.
        !!  It is a simple wrapper around `X(i)%rand(ifnorm)`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10) :: X
        !!      logical                             :: ifnorm = .true.
        !!
        !!      ! ... Your code ...
        !!
        !!      call rand_basis(X, ifnorm)
        !!
        !!      ! ... Your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure rand_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface init_like_basis
        !!  This interface provides methods to initialize an array `X` of `abstract_vector` 
        !!  based on the shape of another array `mold` of `abstract_vector`.
        !!  It is a simple wrapper around `X(i)%init_like(y)`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10), allocatable :: X
        !!      type(my_real_vector) :: mold
        !!
        !!      ! ... Your code ...
        !!
        !!      allocate(X, mold) ; call init_like_basis(X, mold)
        !!
        !!      ! ... Your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure init_like_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface free_basis
        !!  This interface provides methods to free the memory of an array `X` of `abstract_vector`.
        !!  It is a simple wrapper around `X(i)%free()`.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_real_vector), dimension(10), allocatable :: X
        !!      type(my_real_vector) :: mold
        !!
        !!      allocate(X, mold) ; call init_like_basis(X, mold)
        !!
        !!      ! ... Your code ...
        !!
        !!      call free_basis(X)
        !!
        !!      ! ... Your code ...
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure free_basis_${type[0]}$${kind}$
        #:endfor
    end interface

    interface prepare_workspace
        !!  Check and shape a caller-provided workspace.
        !!
        !!  ### Description
        !!
        !!  Routines with an optional `work(:)` argument call this on entry. It stops with an
        !!  error if `size(work) < nwork`, then shapes `work(:nwork)` like `mold` through
        !!  `init_like` (a no-op for vectors that are already conformant). The library never
        !!  frees, deallocates or keeps a reference to a caller-provided workspace: its content
        !!  is undefined on exit, and it can be reused across calls.
        !!
        !!  ### Example
        !!
        !!  ```fortran
        !!      type(my_vector), allocatable :: work(:)
        !!      allocate(work(gmres_work_size(kdim)))
        !!      call init_like_basis(work, b)          ! optional: done by the solver anyway
        !!      call gmres(A, b, x, info, options=opts, work=work)
        !!      ! ... reuse `work` for later solves, then:
        !!      call free_basis(work)
        !!  ```
        #:for kind, type in RC_KINDS_TYPES
        module procedure prepare_workspace_${type[0]}$${kind}$
        #:endfor
    end interface

    interface verify_vector_axioms
        #:for kind, type in RC_KINDS_TYPES
        module procedure verify_vector_axioms_${type[0]}$${kind}$
        #:endfor
    end interface


    type, abstract, public :: abstract_vector
        !!  Base abstract type from which all other types of vectors used in `LightKrylov`
        !!  are being derived from.
        !!
        !!  @warning
        !!  Users should not extend this abstract class to define their own types.
        !!  @endwarning
        logical :: is_initialized = .false.
        !! Set by `init_like`, cleared by `free`. Bookkeeping only for the managed CPU types
        !! here; used by unmanaged-resource (e.g. GPU) extensions to make `free` idempotent.
        logical :: owns_data      = .true.
        !! `.false.` marks an alias/view so `free` won't release shared storage. For GPU/
        !! resource-managing extensions; inert and untested for the CPU types shipped here.
    contains
        procedure(abstract_assign), pass(self), deferred, public :: assign
        !! Copy assignment \( \mathbf{x} \leftarrow \mathbf{y} \) into an existing vector.
        !! Overridable; the kind-level abstract types provide a generic default.
        procedure(abstract_swap), pass(self), deferred, public :: swap
        !! Exchange the full state of two existing vectors; both remain valid.
        !! Overridable; the kind-level abstract types provide a generic default.
        procedure, pass(self), public :: free => free_abstract_vector
        !! Releases the storage owned by `self`. Terminal: after `free`, the only
        !! valid operation on `self` is another `free` (or `init_like`). Idempotent: safe to call
        !! on an already-freed vector. The default only clears `is_initialized`, since the
        !! abstract type cannot see the storage of its extensions. Concrete types should override
        !! it to deallocate their allocatable components (as `dense_vector` does) or release
        !! unmanaged resources (e.g. device buffers), behind a guard so the explicit end-of-use
        !! call and any `final` backstop never double-release.
    end type abstract_vector

    abstract interface
        subroutine abstract_assign(self, from)
            !! Abstract interface for the copy assignment `self <- from`.
            !!
            !! Contract:
            !!
            !! - `self` exists (it may be unshaped) and is reshaped like `from` if needed.
            !! - On exit, `self` holds a deep copy of the values of `from`; the two vectors share
            !!   no storage, and later operations on one never affect the other.
            !! - Storage already held by `self` is reused whenever it is conformant.
            !! - `self` and `from` must not be the same object.
            import abstract_vector
            implicit none(type, external)
            class(abstract_vector), intent(inout) :: self
            !! Destination vector.
            class(abstract_vector), intent(in) :: from
            !! Source vector.
        end subroutine abstract_assign

        subroutine abstract_swap(self, other)
            !! Abstract interface to exchange the content of two vectors.
            !!
            !! Contract:
            !!
            !! - Both vectors exist and are initialized on entry, and remain valid on exit.
            !! - On exit, `self` holds what `other` held on entry and vice versa, including
            !!   ownership (`owns_data`). Nothing is released.
            !! - `self` and `other` must not be the same object.
            import abstract_vector
            implicit none(type, external)
            class(abstract_vector), intent(inout) :: self
            !! First vector.
            class(abstract_vector), intent(inout) :: other
            !! Second vector.
        end subroutine abstract_swap
    end interface

    #:for kind, type in RC_KINDS_TYPES
    !----------------------------------------------------------------------------
    !-----     Definition of an abstract ${type}$ vector with kind=${kind}$     -----
    !----------------------------------------------------------------------------

    type, abstract, extends(abstract_vector), public :: abstract_vector_${type[0]}$${kind}$
        !!  Abstract type to define ${type}$-valued vectors.
        !!  Derived-types defined by the user should be extending one such class.
    contains
        private
        procedure(abstract_zero_${type[0]}$${kind}$), pass(self), deferred, public :: zero
        !! Sets an `abstract_vector_${type[0]}$${kind}$` to zero.
        procedure(abstract_rand_${type[0]}$${kind}$), pass(self), deferred, public :: rand
        !! Creates a random `abstract_vector_${type[0]}$${kind}$`.
        procedure(abstract_scal_${type[0]}$${kind}$), pass(self), deferred, public :: scal
        !! Compute the scalar-vector product.
        procedure(abstract_axpby_${type[0]}$${kind}$), pass(self), deferred, public :: axpby
        !! In-place computation of \( \mathbf{y} \leftarrow \alpha \mathbf{x} + \beta \mathbf{y} \).
        procedure(abstract_dot_${type[0]}$${kind}$), pass(self), deferred, public :: dot
        !! Computes the dot product between two `abstract_vector_${type[0]}$${kind}$`.
        procedure(abstract_get_size_${type[0]}$${kind}$), pass(self), deferred, public :: get_size
        !! Return size of specific abstract vector
        procedure(abstract_init_like_${type[0]}$${kind}$), pass(self), deferred, public :: init_like
        !! Shapes `self` like `mold`: allocates if unallocated, no-op if already conformant,
        !! releases and reallocates if the shape differs. Sole guaranteed allocator for
        !! type-agnostic code; for resource-managing (e.g. GPU) types, this is where device
        !! buffers are allocated/reshaped/released.
        procedure, pass(self), public :: assign => assign_${type[0]}$${kind}$
        !! Default copy assignment: `init_like(from)` followed by `axpby(1, from, 0)`.
        procedure, pass(self), public :: swap => swap_${type[0]}$${kind}$
        !! Default swap: three `assign` through a temporary vector (one allocation). Override it
        !! with a storage exchange (e.g. `move_alloc`) to make it allocation- and copy-free.
        procedure, pass(self), public :: norm => norm_${type[0]}$${kind}$
        !! Computes the norm of the `abstract_vector`.
        procedure, pass(self), public :: add => add_${type[0]}$${kind}$
        !! Adds two `abstract_vector`, i.e. \( \mathbf{y} \leftarrow \mathbf{x} + \mathbf{y}\).
        procedure, pass(self), public :: sub => sub_${type[0]}$${kind}$
        !! Subtracts two `abstract_vector`, i.e. \( \mathbf{y} \leftarrow \mathbf{y} - \mathbf{x} \).
        procedure, pass(self), public :: chsgn => chsgn_${type[0]}$${kind}$
        !! Change the sign of a vector, i.e. \( \mathbf{x} \leftarrow -\mathbf{x} \).
    end type abstract_vector_${type[0]}$${kind}$

    abstract interface
        subroutine abstract_zero_${type[0]}$${kind}$(self)
            !! Abstract interface to zero-out a vector in-place.
            import abstract_vector_${type[0]}$${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
            !! Vector to be zeroed-out.
        end subroutine abstract_zero_${type[0]}$${kind}$

        subroutine abstract_rand_${type[0]}$${kind}$(self, ifnorm)
            !! Abstract interface to generate a random (normalized) vector.
            import abstract_vector_${type[0]}$${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
            !! Vector to be initialized.
            logical, optional, intent(in) :: ifnorm
        end subroutine abstract_rand_${type[0]}$${kind}$

        subroutine abstract_scal_${type[0]}$${kind}$(self, alpha)
            !! Abstract interface to scale a vector.
            import abstract_vector_${type[0]}$${kind}$, ${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
            !! Vector to be scaled.
            ${type}$, intent(in) :: alpha
            !! Scaling factor.
        end subroutine abstract_scal_${type[0]}$${kind}$

        subroutine abstract_axpby_${type[0]}$${kind}$(alpha, vec, beta, self)
            !! Abstract interface to add/scale two vectors in-place.
            import abstract_vector_${type[0]}$${kind}$, ${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
            !! Input/Output vector.
            class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec
            !! Vector to be added/subtracted.
            ${type}$, intent(in) :: alpha, beta
        end subroutine abstract_axpby_${type[0]}$${kind}$

        function abstract_dot_${type[0]}$${kind}$(self, vec) result(alpha)
            !! Abstract interface to compute the dot product.
            import abstract_vector_${type[0]}$${kind}$, ${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(in) :: self, vec
            !! Vectors whose dot product will be computed.
            ${type}$ :: alpha
            !! Result of the dot product.
        end function abstract_dot_${type[0]}$${kind}$

        function abstract_get_size_${type[0]}$${kind}$(self) result(N)
            !! Abstract interface to return the size of the specific abstract vector.
            import abstract_vector_${type[0]}$${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(in) :: self
            !! Vector for which to return the size.
            integer :: N
            !! Size of the vector
        end function abstract_get_size_${type[0]}$${kind}$

        subroutine abstract_init_like_${type[0]}$${kind}$(self, mold)
            !! Abstract interface to shape `self` like `mold`.
            !!
            !! Contract — the implementation must leave `self` shaped like `mold`, handling
            !! three cases:
            !!
            !! - `self` unallocated            : allocate internal storage from `mold`'s shape.
            !! - `self` allocated, conformant  : no-op (cheap fast path; do not reallocate).
            !! - `self` allocated, nonconformant: release prior storage, then reallocate.
            !!
            !! Must be idempotent. This is the sole guaranteed allocator used by type-agnostic
            !! algorithms, which call it immediately after `allocate(self, mold=...)`. For types
            !! holding unmanaged resources (e.g. device buffers), this routine owns their
            !! allocation, reshaping, and release.
            import abstract_vector_${type[0]}$${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
            !! Vector to be shaped.
            class(abstract_vector_${type[0]}$${kind}$), intent(in) :: mold
            !! Vector whose shape `self` should match.
        end subroutine abstract_init_like_${type[0]}$${kind}$

    end interface

    #:endfor

    #:for kind, type in RC_KINDS_TYPES
    !----------------------------------------------------------------------------------
    !-----     Convenience vector type to wrap standard Fortran rank-1 arrays     -----
    !----------------------------------------------------------------------------------

    type, extends(abstract_vector_${type[0]}$${kind}$), public :: dense_vector_${type[0]}$${kind}$
        integer :: n = 0
        ${type}$, allocatable :: data(:)
    contains
        private
        procedure, pass(self), public :: zero => dense_zero_${type[0]}$${kind}$
        !! Sets an `abstract_vector_${type[0]}$${kind}$` to zero.
        procedure, pass(self), public :: rand => dense_rand_${type[0]}$${kind}$
        !! Creates a random `abstract_vector_${type[0]}$${kind}$`.
        procedure, pass(self), public :: scal => dense_scal_${type[0]}$${kind}$
        !! Compute the scalar-vector product.
        procedure, pass(self), public :: axpby => dense_axpby_${type[0]}$${kind}$
        !! In-place computation of \( \mathbf{y} \leftarrow \alpha \mathbf{x} + \beta \mathbf{y} \).
        procedure, pass(self), public :: dot => dense_dot_${type[0]}$${kind}$
        !! Computes the dot product between two `abstract_vector_${type[0]}$${kind}$`.
        procedure, pass(self), public :: get_size => dense_get_size_${type[0]}$${kind}$
        !! Return size of specific abstract vector
        procedure, pass(self), public :: init_like => dense_init_like_${type[0]}$${kind}$
        !! Initialize `self` like `mold`: allocate if unallocated, no-op if already conformant, 
        !! release and reallocate if the shape differs.
        procedure, pass(self), public :: assign => dense_assign_${type[0]}$${kind}$
        !! Copy assignment through a direct array copy.
        procedure, pass(self), public :: swap => dense_swap_${type[0]}$${kind}$
        !! Copy-free swap exchanging the underlying allocations with `move_alloc`.
        procedure, pass(self), public :: free => dense_free_${type[0]}$${kind}$
        !! Deallocates the underlying array (idempotent).
    end type dense_vector_${type[0]}$${kind}$
    #:endfor

    interface dense_vector
        #:for kind, type in RC_KINDS_TYPES
        module procedure initialize_dense_vector_from_array_${type[0]}$${kind}$
        #:endfor
    end interface
    public :: dense_vector

contains

    !-------------------------------------------------------------------
    !-----     TYPE-BOUND PROCEDURES FOR THE ROOT ABSTRACT VECTOR     -----
    !-------------------------------------------------------------------

    subroutine free_abstract_vector(self)
        implicit none(type, external)
        !! Default `free`. The abstract type cannot see the storage of its extensions, so this
        !! only clears the `is_initialized` flag (making the action terminal). Concrete types
        !! override it to deallocate their components or release unmanaged resources.
        class(abstract_vector), intent(inout) :: self
        self%is_initialized = .false.
    end subroutine free_abstract_vector

    !-----------------------------------------------------------------------
    !-----     TYPE-BOUND PROCEDURES FOR THE ABSTRACT VECTOR TYPES     -----
    !-----------------------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    function norm_${type[0]}$${kind}$(self) result(alpha)
        implicit none(type, external)
        !! Compute the norm of an `abstract_vector`.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: self
        !! Vector whose norm needs to be computed.
        real(${kind}$) :: alpha
        !! Norm of the vector.
        alpha = abs(self%dot(self)) ; alpha = sqrt(alpha)
    end function norm_${type[0]}$${kind}$

    subroutine sub_${type[0]}$${kind}$(self, vec)
        implicit none(type, external)
        !! Subtract two `abstract_vector` in-place.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
        !! Input/Output vector.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec
        !! Vector to be subtracted.
        call self%axpby(-one_${type[0]}$${kind}$, vec, one_${type[0]}$${kind}$)
    end subroutine sub_${type[0]}$${kind}$

    subroutine add_${type[0]}$${kind}$(self, vec)
        implicit none(type, external)
        !! Add two `abstract_vector` in-place.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
        !! Input/Output vector.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec
        !! Vector to be added.
        call self%axpby(one_${type[0]}$${kind}$, vec, one_${type[0]}$${kind}$)
    end subroutine add_${type[0]}$${kind}$

    subroutine chsgn_${type[0]}$${kind}$(self)
        implicit none(type, external)
        !! Changes the sign of the `abstract_vector`.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
        !! Vector whose entries need to change sign.
        call self%scal(-one_${type[0]}$${kind}$)
    end subroutine chsgn_${type[0]}$${kind}$

    subroutine assign_${type[0]}$${kind}$(self, from)
        implicit none(type, external)
        !! Default copy assignment `self <- from`, built on the user-provided hooks:
        !! `init_like` (no-op if `self` is already conformant) followed by `axpby(1, from, 0)`.
        !! Types for which `axpby` with `beta = 0` does not overwrite non-finite values in
        !! `self`, or that have a cheaper native copy, should override `assign`.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
        !! Destination vector.
        class(abstract_vector), intent(in) :: from
        !! Source vector.
        select type (from)
        class is (abstract_vector_${type[0]}$${kind}$)
            call self%init_like(from)
            call self%axpby(one_${type[0]}$${kind}$, from, zero_${type[0]}$${kind}$)
        class default
            call type_error('from', 'abstract_vector_${type[0]}$${kind}$', 'IN', this_module, &
                          & 'assign_${type[0]}$${kind}$')
        end select
    end subroutine assign_${type[0]}$${kind}$

    subroutine swap_${type[0]}$${kind}$(self, other)
        implicit none(type, external)
        !! Default swap through a temporary vector: one allocation and three `assign`.
        !! Types able to exchange their storage directly should override `swap`.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: self
        !! First vector.
        class(abstract_vector), intent(inout) :: other
        !! Second vector.

        ! Internal variables.
        class(abstract_vector_${type[0]}$${kind}$), allocatable :: tmp
        integer :: iostat
        character(len=100) :: errmsg

        select type (other)
        class is (abstract_vector_${type[0]}$${kind}$)
            allocate(tmp, mold=self, stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "swap_${type[0]}$${kind}$")
            call tmp%init_like(self)
            call tmp%assign(self)
            call self%assign(other)
            call other%assign(tmp)
            ! Release the content of the temporary, then the temporary itself.
            call tmp%free()
            deallocate(tmp)
        class default
            call type_error('other', 'abstract_vector_${type[0]}$${kind}$', 'INOUT', this_module, &
                          & 'swap_${type[0]}$${kind}$')
        end select
    end subroutine swap_${type[0]}$${kind}$

    #:endfor

    !--------------------------------------------------------------------------------
    !-----     TYPE-BOUND PROCEDURES FOR THE CONVENIENCE DENSE VECTOR TYPES     -----
    !--------------------------------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    function initialize_dense_vector_from_array_${type[0]}$${kind}$(x) result(vec)
        implicit none(type, external)
        ${type}$, intent(in) :: x(:)
        type(dense_vector_${type[0]}$${kind}$) :: vec
        vec%n = size(x) ; vec%data = x
        vec%is_initialized = .true.
    end function initialize_dense_vector_from_array_${type[0]}$${kind}$

    subroutine dense_zero_${type[0]}$${kind}$(self)
        implicit none(type, external)
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        integer :: iostat
        character(len=100) :: errmsg
        if(.not. allocated(self%data)) then
            allocate(self%data(self%n), stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "dense_zero_${type[0]}$${kind}$")
        endif
        self%data = zero_${type[0]}$${kind}$
    end subroutine dense_zero_${type[0]}$${kind}$

    subroutine dense_rand_${type[0]}$${kind}$(self, ifnorm)
        implicit none(type, external)
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        logical, optional, intent(in) :: ifnorm
        integer :: iostat
        character(len=100) :: errmsg
        #:if type[0] == "c"
        real(${kind}$), allocatable :: y(:, :)
        #:endif

        ! Make sure the storage exists (same convention as `dense_zero`).
        if (.not. allocated(self%data)) then
            allocate(self%data(self%n), stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "dense_rand_${type[0]}$${kind}$")
        endif

        ! Fill with random entries.
        #:if type[0] == "r"
        call random_number(self%data); self%data = 2.0_${kind}$*self%data - 1.0_${kind}$
        #:else
        allocate(y(size(self%data), 2), stat=iostat, errmsg=errmsg)
        call check_allocation(iostat, errmsg, this_module, "dense_rand_${type[0]}$${kind}$")
        call random_number(y)
        self%data%re = 2.0_${kind}$*y(:, 1) - 1.0_${kind}$ ; self%data%im = 2.0_${kind}$*y(:, 2) - 1.0_${kind}$
        deallocate(y)
        #:endif

        ! Normalize if requested.
        if (optval(ifnorm, .false.)) call self%scal(one_${type[0]}$${kind}$ / self%norm())
    end subroutine dense_rand_${type[0]}$${kind}$

    subroutine dense_scal_${type[0]}$${kind}$(self, alpha)
        implicit none(type, external)
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        ${type}$, intent(in) :: alpha
        integer :: n
        n = self%get_size()
        call scal(n, alpha, self%data, 1)
    end subroutine dense_scal_${type[0]}$${kind}$

    subroutine dense_axpby_${type[0]}$${kind}$(alpha, vec, beta, self)
        implicit none(type, external)
        ${type}$, intent(in) :: alpha, beta
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec
        integer :: n, m, iostat
        character(len=100) :: errmsg
        m = vec%get_size()
        if(.not. allocated(self%data)) then
            allocate(self%data(m), source=zero_${type[0]}$${kind}$, stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "dense_axpby_${type[0]}$${kind}$")
            self%n = m ; self%is_initialized = .true.
        endif
        n = self%get_size()
        if (m /= n) call stop_error("Inconsistent size between the two vectors.", this_module, 'dense_axpby_${type[0]}$${kind}$')

        select type (vec)
        type is(dense_vector_${type[0]}$${kind}$)
            if (beta == zero_${type[0]}$${kind}$) then
                self%data = zero_${type[0]}$${kind}$
            else
                call self%scal(beta)
            end if
            call axpy(n, alpha, vec%data, 1, self%data, 1)
        class default
            call type_error('vec','dense_vector_${type[0]}$${kind}$','IN',this_module,'dense_axpby_${type[0]}$${kind}$')
        end select
    end subroutine dense_axpby_${type[0]}$${kind}$

    function dense_dot_${type[0]}$${kind}$(self, vec) result(alpha)
        implicit none(type, external)
        class(dense_vector_${type[0]}$${kind}$), intent(in) :: self
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec
        ${type}$ :: alpha
        integer :: n
        n = self%get_size()
        select type (vec)
        type is(dense_vector_${type[0]}$${kind}$)
            #:if type[0] == "r"
            alpha = dot(n, self%data, 1, vec%data, 1)
            #:else
            alpha = dotc(n, self%data, 1, vec%data, 1)
            #:endif
        class default
            call type_error('vec','dense_vector_${type[0]}$${kind}$','IN',this_module,'dense_dot_${type[0]}$${kind}$')
        end select
    end function dense_dot_${type[0]}$${kind}$

    function dense_get_size_${type[0]}$${kind}$(self) result(n)
        implicit none(type, external)
        class(dense_vector_${type[0]}$${kind}$), intent(in) :: self
        integer :: n
        if (.not. allocated(self%data)) then
            n = 0
        else
            n = size(self%data)
        end if
    end function dense_get_size_${type[0]}$${kind}$

    subroutine dense_init_like_${type[0]}$${kind}$(self, mold)
        implicit none(type, external)
        !! Shape `self` like `mold` (three cases: allocate / no-op / reallocate).
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        class(abstract_vector_${type[0]}$${kind}$), intent(in)  :: mold
        integer :: m, iostat
        character(len=100) :: errmsg

        ! mold must be the same concrete type to read its size.
        select type (mold)
        type is (dense_vector_${type[0]}$${kind}$)
            m = mold%get_size()
        class default
            call type_error('mold','dense_vector_${type[0]}$${kind}$','IN',this_module,'dense_init_like_${type[0]}$${kind}$')
        end select

        if (.not. allocated(self%data)) then
            ! Case 1: unallocated -> allocate.
            allocate(self%data(m), stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "dense_init_like_${type[0]}$${kind}$")
        else if (size(self%data) /= m) then
            ! Case 3: allocated but nonconformant -> release, reallocate.
            deallocate(self%data)
            allocate(self%data(m), stat=iostat, errmsg=errmsg)
            call check_allocation(iostat, errmsg, this_module, "dense_init_like_${type[0]}$${kind}$")
        end if
        ! Case 2: allocated and conformant -> fall through, no realloc.

        self%n = m
        self%is_initialized = .true.
    end subroutine dense_init_like_${type[0]}$${kind}$

    subroutine dense_assign_${type[0]}$${kind}$(self, from)
        implicit none(type, external)
        !! Copy assignment through a direct array copy (storage of `self` reused if conformant).
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        class(abstract_vector), intent(in) :: from
        select type (from)
        type is (dense_vector_${type[0]}$${kind}$)
            call self%init_like(from)
            self%data(:) = from%data(:)
        class default
            call type_error('from', 'dense_vector_${type[0]}$${kind}$', 'IN', this_module, &
                          & 'dense_assign_${type[0]}$${kind}$')
        end select
    end subroutine dense_assign_${type[0]}$${kind}$

    subroutine dense_swap_${type[0]}$${kind}$(self, other)
        implicit none(type, external)
        !! Copy-free swap: the two allocations change hands through `move_alloc`, so that no
        !! data is copied and nothing is allocated.
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        class(abstract_vector), intent(inout) :: other
        ${type}$, allocatable :: tmp(:)
        integer :: n
        logical :: flag
        select type (other)
        type is (dense_vector_${type[0]}$${kind}$)
            call move_alloc(self%data, tmp)
            call move_alloc(other%data, self%data)
            call move_alloc(tmp, other%data)
            ! `tmp` is unallocated after the last `move_alloc`: nothing to release.
            n = self%n ; self%n = other%n ; other%n = n
            flag = self%is_initialized ; self%is_initialized = other%is_initialized ; other%is_initialized = flag
            flag = self%owns_data ; self%owns_data = other%owns_data ; other%owns_data = flag
        class default
            call type_error('other', 'dense_vector_${type[0]}$${kind}$', 'INOUT', this_module, &
                          & 'dense_swap_${type[0]}$${kind}$')
        end select
    end subroutine dense_swap_${type[0]}$${kind}$

    subroutine dense_free_${type[0]}$${kind}$(self)
        implicit none(type, external)
        !! Deallocates the underlying array so that its memory is returned immediately, rather
        !! than when the object itself goes out of scope. Idempotent; `init_like` reallocates.
        !! An allocatable component can never alias another vector, so `owns_data` plays no role.
        class(dense_vector_${type[0]}$${kind}$), intent(inout) :: self
        if (allocated(self%data)) deallocate(self%data)
        self%n = 0
        self%is_initialized = .false.
    end subroutine dense_free_${type[0]}$${kind}$

    #:endfor

    !--------------------------------------
    !-----      UTILITY FUNCTIONS     -----
    !--------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    subroutine linear_combination_vector_${type[0]}$${kind}$(y, X, v)
        !! Given `X` and `v`, this function computes in-place \( \mathbf{y} = \mathbf{Xv} \) where
        !! `y` is an `abstract_vector`, `X` an array of `abstract_vector` and `v` a
        !! Fortran array containing the coefficients of the linear combination.
        !! `y` is provided (allocated) by the caller and must not alias any element of `X`.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: y
        !! Ouput vector. Shaped like `X(1)` (no-op if conformant); its content is overwritten.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:)
        !! Krylov basis.
        ${type}$, intent(in) :: v(:)
        !! Coordinates of `y` in the Krylov basis `X`.

        ! Internal variables
        integer :: i

        ! Check sizes.
        if (size(X) /= size(v)) then
            call stop_error("Krylov basis X and low-dimensional vector v have different sizes.", &
                              & this_module, 'linear_combination_vector_${type[0]}$${kind}$')
        endif
        if (size(X) == 0) then
            call stop_error("Krylov basis X is empty.", &
                              & this_module, 'linear_combination_vector_${type[0]}$${kind}$')
        endif

        ! Shape output vector.
        call y%init_like(X(1))
        call y%zero()
        ! Compute linear combination.
        do i = 1, size(X)
            call y%axpby(v(i), X(i), one_${type[0]}$${kind}$) ! y = y + X[i]*v[i]
        enddo
    end subroutine linear_combination_vector_${type[0]}$${kind}$

    subroutine linear_combination_matrix_${type[0]}$${kind}$(Y, X, B)
        !! Given `X` and `B`, this function computes in-place \(\mathbf{Y} = \mathbf{XB} \) where
        !! `X` and `Y` are arrays of `abstract_vector`, and `B` is a 2D Fortran array.
        !! `Y` is provided (allocated) by the caller with `size(Y) == size(B, 2)` and must not
        !! alias any element of `X`.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: Y(:)
        !! Output matrix. Shaped like `X(1)` (no-op if conformant); its content is overwritten.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:)
        !! Krylov basis.
        ${type}$, intent(in) :: B(:, :)
        !! Coefficients of the linear combinations.

        ! Internal variables.
        integer :: i, j

        ! Check sizes.
        if (size(X) /= size(B, 1)) then
            call stop_error("Krylov basis X and combination matrix B have incompatible sizes.", &
                            this_module, 'linear_combination_matrix_${type[0]}$${kind}$')
        endif
        if (size(Y) /= size(B, 2)) then
            call stop_error("Output basis Y and combination matrix B have incompatible sizes.", &
                            this_module, 'linear_combination_matrix_${type[0]}$${kind}$')
        endif
        if (size(X) == 0) then
            call stop_error("Krylov basis X is empty.", &
                            this_module, 'linear_combination_matrix_${type[0]}$${kind}$')
        endif

        ! Shape output basis.
        call init_like_basis(Y, X(1))

        call zero_basis(Y)
        do j = 1, size(Y)
            do i = 1, size(X)
                call Y(j)%axpby(B(i, j), X(i), one_${type[0]}$${kind}$) ! y(j) = B(i,j)*X(i) + y(j)
            enddo
        enddo
    end subroutine linear_combination_matrix_${type[0]}$${kind}$

    function gram_matrix_${type[0]}$${kind}$(X) result(G)
        !! Computes the inner product/Gram matrix associated with the basis \( \mathbf{X} \).
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:)
        ${type}$ :: G(size(X), size(X))
        integer :: i, j
        do i = 1, size(X)
            do j = i, size(X)
                G(i, j) = X(i)%dot(X(j))
                #:if type[0] == "r"
                G(j, i) = G(i, j)
                #:else
                G(j, i) = conjg(G(i, j))
                #:endif
            enddo
        enddo
    end function gram_matrix_${type[0]}$${kind}$

    function innerprod_vector_${type[0]}$${kind}$(X, v) result(y)
        !! Computes the inner product vector \( \mathbf{y} = \mathbf{X}^H \mathbf{v} \) between
        !! a basis `X` of `abstract_vector` and `v`, a single `abstract_vector`.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:), v
        !! Basis and single instance of `abstract_vector` whose inner products need to be computed.
        ${type}$ :: y(size(X))
        !! Resulting inner-product vector.

        ! Local variables.
        integer :: i

        y = zero_${type[0]}$${kind}$
        do i = 1, size(X)
            y(i) = X(i)%dot(v)
        enddo
    end function innerprod_vector_${type[0]}$${kind}$

    function innerprod_matrix_${type[0]}$${kind}$(X, Y) result(M)
        !! Computes the inner product matrix \( \mathbf{M} = \mathbf{X}^H \mathbf{Y} \) between
        !! two bases of `abstract_vector`.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:), Y(:)
        !! Bases of `abstract_vector` whose inner products need to be computed.
        ${type}$ :: M(size(X), size(Y))
        !! Resulting inner-product matrix.

        ! Local variables.
        integer :: i, j

        M = zero_${type[0]}$${kind}$
        do j = 1, size(Y)
            do i = 1, size(X)
                M(i, j) = X(i)%dot(Y(j))
            enddo
        enddo
    end function innerprod_matrix_${type[0]}$${kind}$

    impure elemental subroutine axpby_basis_${type[0]}$${kind}$(alpha, X, beta, Y)
        !! Compute in-place \( \mathbf{Y} \leftarrow \alpha \mathbf{X} + \beta \mathbf{Y} \) where
        !! `X` and `Y` are arrays of `abstract_vector` and `alpha` and `beta` are ${type}$
        !! numbers.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X
        !! Input/Ouput array of `abstract_vector`.
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: Y
        !! Array of `abstract_vector` to be added/subtracted to/from `X`.
        ${type}$, intent(in) :: alpha, beta
        !! Scalar multipliers.
        call Y%axpby(alpha, X, beta)
    end subroutine axpby_basis_${type[0]}$${kind}$

    impure elemental subroutine zero_basis_${type[0]}$${kind}$(X)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X
        call X%zero()
    end subroutine zero_basis_${type[0]}$${kind}$

    impure elemental subroutine copy_vector_${type[0]}$${kind}$(out, from)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: from
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: out
        ! Dispatch to the copy-assignment hook of the concrete type.
        call out%assign(from)
    end subroutine copy_vector_${type[0]}$${kind}$

    impure elemental subroutine init_like_basis_${type[0]}$${kind}$(X, mold)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X
        class(abstract_vector_${type[0]}$${kind}$), intent(in)    :: mold
        call X%init_like(mold)
    end subroutine init_like_basis_${type[0]}$${kind}$

    impure elemental subroutine free_basis_${type[0]}$${kind}$(X)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X
        call X%free()
    end subroutine free_basis_${type[0]}$${kind}$
    
    subroutine prepare_workspace_${type[0]}$${kind}$(work, nwork, mold, module, procedure)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: work(:)
        !! Caller-provided workspace.
        integer, intent(in) :: nwork
        !! Number of vectors required by the calling routine.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: mold
        !! Vector whose shape the workspace must match.
        character(len=*), intent(in) :: module
        !! Module of the calling routine (for error reporting).
        character(len=*), intent(in) :: procedure
        !! Calling routine (for error reporting).
        character(len=256) :: msg
        if (size(work) < nwork) then
            write(msg, '(A,I0,A,I0,A)') 'Workspace too small: size(work) = ', size(work), &
                                      & ', at least ', nwork, ' vectors are required.'
            call stop_error(msg, module, procedure)
        endif
        if (nwork > 0) call init_like_basis(work(:nwork), mold)
    end subroutine prepare_workspace_${type[0]}$${kind}$

    impure elemental subroutine rand_basis_${type[0]}$${kind}$(X, ifnorm)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X
        logical, optional, intent(in) :: ifnorm
        call X%rand(ifnorm=ifnorm)
    end subroutine rand_basis_${type[0]}$${kind}$

    logical function verify_vector_axioms_${type[0]}$${kind}$(x, ntrials, tolerance) result(success)
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: x
        !! Derived-type whose implementation needs to be tested.
        integer, optional, intent(in) :: ntrials
        !! Number of random samples generated for the tests.
        real(${kind}$), optional, intent(in) :: tolerance

        integer :: ntrials_, i
        real(${kind}$) :: tol
        character(len=128) :: failed_test
        character(len=256) :: msg

        !> Deals with optional argument.
        ntrials_ = optval(ntrials, 100)
        if (ntrials_ <= 0) then
            write(msg, '(A,I0,A)') "Number of trials must be positive: ntrials = ", ntrials_, "."
            call stop_error(msg, this_module, "verify_vector_axioms_${type[0]}$${kind}$")
        end if
        tol = optval(tolerance, 10.0_${kind}$**(-(precision(1.0_${kind}$)-1)))

        !> Run all tests to verify axioms.
        success = .false.
        verification: do i = 1, ntrials_

            !-----------------------------------
            !-----     VECTOR ADDITION     -----
            !-----------------------------------

            addition_associativity: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v, w
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: wrk1, wrk2

                !> Generate random vectors.
                allocate(u, v, w, wrk1, wrk2, mold=x)
                call u%init_like(x) ; call u%rand()
                call v%init_like(x) ; call v%rand()
                call w%init_like(x) ; call w%rand()

                !> Check distributivity.
                call copy(wrk1, v)
                call copy(wrk2, v)
                call wrk1%add(w)    ! v + w
                call wrk2%add(u)    ! u + v

                call u%add(wrk1)    ! u + (v + w)
                call w%add(wrk2)    ! (u + v) + w

                call u%sub(w)

                !> Check correctness.
                success = merge(.true., .false., u%norm() <= tol)

                !> Cleanup.
                call wrk1%free() ; call wrk2%free()
                call u%free() ; call v%free() ; call w%free()
                deallocate(u, v, w, wrk1, wrk2)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'addition_associativity'
                    exit verification
                end if
            end block addition_associativity

            addition_commutativity: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v, w

                !> Generate random vectors.
                allocate(u, v, w, mold=x)
                call u%init_like(x) ; call u%rand()
                call v%init_like(x) ; call v%rand()
                call copy(w, v)

                !> Check commutativity.
                call v%add(u)
                call u%add(w)

                call u%sub(v)

                !> Check correctness.
                success = merge(.true., .false., u%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free() ; call w%free()
                deallocate(u, v, w)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'addition_commutativity'
                    exit verification
                end if
            end block addition_commutativity

            addition_zero: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v, z

                !> Generate random vector.
                allocate(u, v, z, mold=x)
                call u%init_like(x) ; call u%rand()
                call copy(v, u)
                call z%init_like(x) ; call z%zero()

                !> Check zero element.
                call u%add(z)
                call u%sub(v)

                !> Check correctness
                success = merge(.true., .false., u%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free() ; call z%free()
                deallocate(u, v, z)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'addition_zero'
                    exit verification
                end if
            end block addition_zero

            additive_inverse: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v
                allocate(u, v, mold=x)
                call u%init_like(x) ; call u%rand()
                call copy(v, u)
                call u%sub(v)

                !> Check correctness.
                success = merge(.true., .false., u%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free()
                deallocate(u, v)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'additive_inverse'
                    exit verification
                end if
            end block additive_inverse

            !-----------------------------------------
            !-----     SCALAR MULTIPLICATION     -----
            !-----------------------------------------
            scaling_identity: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v
                ${type}$, parameter :: one = 1.0_${kind}$

                !> Generate random vector.
                allocate(u, v, mold=x)
                call u%init_like(x) ; call u%rand()
                call copy(v, u)
                
                call v%scal(one)
                call u%sub(v)

                !> Check correctness
                success = merge(.true., .false., u%norm() <= tol)
                
                !> Cleanup.
                call u%free() ; call v%free()
                deallocate(u, v)
                
                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'scaling_identity'
                    exit verification
                end if
            end block scaling_identity

            scaling_compatibility: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v
                ${type}$ :: a, b
                #:if type.startswith('complex')
                real(${kind}$) :: c(2)
                call random_number(c)
                a = cmplx(c(1), c(2), kind=${kind}$)
                call random_number(c)
                b = cmplx(c(1), c(2), kind=${kind}$)
                #:else
                call random_number(a)
                call random_number(b)
                #:endif

                !> Generate random vectors.
                allocate(u, v, mold=x)
                call u%init_like(x) ; call u%rand(ifnorm=.true.)
                call copy(v, u)

                !> Check associativity.
                call v%scal(b)
                call v%scal(a)
                call u%scal(a*b)
                call u%sub(v)

                !> Check correctness.
                success = merge(.true., .false., u%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free()
                deallocate(u, v)
                
                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'scaling_compatibility'
                    exit verification
                end if
            end block scaling_compatibility

            scaling_distributivity: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v, w
                ${type}$ :: a
                #:if type.startswith('complex')
                real(${kind}$) :: b(2)
                call random_number(b)
                a = cmplx(b(1), b(2), kind=${kind}$)
                #:else
                call random_number(a)
                #:endif

                !> Generate random vectors.
                allocate(u, v, w, mold=x)
                call u%init_like(x) ; call u%rand()
                call v%init_like(x) ; call v%rand()
                call copy(w, u)

                !> Check distributivity.
                call w%add(v)
                call w%scal(a)

                call u%scal(a)
                call v%scal(a)
                call v%add(u)

                call v%sub(w)

                !> Check correctness.
                success = merge(.true., .false., v%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free() ; call w%free()
                deallocate(u, v, w)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'scaling_distributivity'
                    exit verification
                end if
            end block scaling_distributivity

            scaling_distributivity_bis: block
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v
                ${type}$ :: a, b
                #:if type.startswith('complex')
                real(${kind}$) :: c(2)
                call random_number(c)
                a = cmplx(c(1), c(2), kind=${kind}$)
                call random_number(c)
                b = cmplx(c(1), c(2), kind=${kind}$)
                #:else
                call random_number(a)
                call random_number(b)
                #:endif

                !> Generate random vector.
                allocate(u, v, mold=x)
                call u%init_like(x) ; call u%rand()
                call copy(v, u)

                !> Check distributivity.
                call v%axpby(a, u, b)
                call u%scal(a+b)

                call v%sub(u)

                !> Check correctness.
                success = merge(.true., .false., v%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free()
                deallocate(u, v)

                !>  Exit if the test fails.
                if (.not. success) then
                    failed_test = 'scaling_distributivity_bis'
                    exit verification
                end if
            end block scaling_distributivity_bis

            !-----------------------------------------
            !-----     LIFECYCLE HOOKS           -----
            !-----------------------------------------

            assign_correctness: block
                !! `v%assign(u)` must yield v = u, and v must not share storage with u.
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v
                real(${kind}$) :: vnorm

                !> Generate random source and a differently-filled destination.
                allocate(u, v, mold=x)
                call u%init_like(x) ; call u%rand()
                call v%init_like(x) ; call v%rand()

                !> Copy assignment.
                call v%assign(u)
                vnorm = v%norm()

                !> Independence: scaling u must leave v untouched.
                call u%scal(2*one_${type[0]}$${kind}$)
                success = abs(v%norm() - vnorm) <= tol

                !> Correctness: u - 2v = 0 (scaling by 2 is exact).
                call u%axpby(-2*one_${type[0]}$${kind}$, v, one_${type[0]}$${kind}$)
                success = success .and. (u%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free()
                deallocate(u, v)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'assign_correctness'
                    exit verification
                end if
            end block assign_correctness

            swap_correctness: block
                !! After `u%swap(v)`, u must hold v's content and v must hold u's, both valid.
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u, v, u0, v0

                !> Generate random vectors and keep reference copies.
                allocate(u, v, u0, v0, mold=x)
                call u%init_like(x) ; call u%rand()
                call v%init_like(x) ; call v%rand()
                call u0%init_like(x) ; call u0%assign(u)
                call v0%init_like(x) ; call v0%assign(v)

                !> Swap.
                call u%swap(v)

                !> Check correctness.
                call u%sub(v0) ; call v%sub(u0)
                success = (u%norm() <= tol) .and. (v%norm() <= tol)

                !> Cleanup.
                call u%free() ; call v%free() ; call u0%free() ; call v0%free()
                deallocate(u, v, u0, v0)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'swap_correctness'
                    exit verification
                end if
            end block swap_correctness

            mold_independence: block
                !! guard for resource-sharing overrides (GPU), void for CPU applications.
                class(abstract_vector_${type[0]}$${kind}$), allocatable :: u
                real(${kind}$) :: xnorm

                !> Generate random vector.
                xnorm = x%norm()
                allocate(u, mold=x)
                call u%init_like(x) ; call u%rand()

                ! x must be unaffected by operations on u (checking init_like compliance).
                call u%scal(2*one_${type[0]}$${kind}$)

                !> Check correctness.
                success = merge(.true., .false., abs(x%norm() - xnorm) <= tol)

                ! Cleanup.
                call u%free()
                deallocate(u)

                !> Exit if the test fails.
                if (.not. success) then
                    failed_test = 'mold_independence'
                    exit verification
                end if
            end block mold_independence
        enddo verification
        if (success) then
            write(msg, '(A,I0,A)') 'All vector axioms verified (', ntrials_, ' trials).'
            call log_information(msg, this_module, 'verify_vector_axioms_${type[0]}$${kind}$')
        else
            write(msg, '(A,I0,A)') 'Vector axiom check FAILED at trial ', i, ', test: '//trim(failed_test)
            call log_warning(msg, this_module, 'verify_vector_axioms_${type[0]}$${kind}$')
        end if
    end function verify_vector_axioms_${type[0]}$${kind}$

    #:endfor
end module LightKrylov_AbstractVectors