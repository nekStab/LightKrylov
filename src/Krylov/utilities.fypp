#:include "../../include/common.fypp"
#:set RC_KINDS_TYPES = REAL_KINDS_TYPES + CMPLX_KINDS_TYPES
submodule (lightkrylov_basekrylov) krylov_utilities
    implicit none(type, external)
contains

    !----------------------------------------
    !-----     Permutation matrices     -----
    !----------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure permcols_basis_${type[0]}$${kind}$
        !! In-place column permutation `Q <- Q(perm)` by cycle decomposition: each cycle of
        !! length L is applied with L-1 calls to the `swap` hook. No work basis is needed, and
        !! no data is copied for types whose `swap` exchanges storage.
        character(len=*), parameter :: this_procedure = 'permcols_basis_${type[0]}$${kind}$'
        logical :: done(size(Q))
        integer :: n, s, i, j

        ! Check that perm is a permutation of 1..size(Q).
        n = size(Q)
        if (size(perm) /= n) call stop_error("perm and Q have different sizes.", this_module, this_procedure)
        done = .false.
        do i = 1, n
            if (perm(i) < 1 .or. perm(i) > n) then
                call stop_error("perm has an out-of-range entry.", this_module, this_procedure)
            else if (done(perm(i))) then
                call stop_error("perm has a repeated entry.", this_module, this_procedure)
            endif
            done(perm(i)) = .true.
        enddo

        ! Follow each cycle s -> perm(s) -> perm(perm(s)) -> ... back to s.
        done = .false.
        do s = 1, n
            if (done(s)) cycle
            done(s) = .true.
            i = s ; j = perm(i)
            do while (j /= s)
                ! Q(i) receives its final content (old Q(perm(i))).
                call Q(i)%swap(Q(j))
                done(j) = .true.
                i = j ; j = perm(i)
            enddo
        enddo
    end procedure permcols_basis_${type[0]}$${kind}$

    module procedure permcols_array_${type[0]}$${kind}$
        Q = Q(:, perm)
    end procedure permcols_array_${type[0]}$${kind}$
    #:endfor

    module procedure invperm
        integer :: i, iostat
        character(len=100) :: errmsg
        allocate(inv_perm(size(perm)), source=0, stat=iostat, errmsg=errmsg)
        call check_allocation(iostat, errmsg, this_module, "invperm")
        inv_perm(perm) = [(i, i=1, size(perm))]
    end procedure invperm

    !----------------------------------------------
    !-----     Initialize Krylov subspace     -----
    !----------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure initialize_krylov_subspace_${type[0]}$${kind}$
        integer :: p

        ! Zero-out X.
        call zero_basis(X)

        ! Deals with optional args.
        if(present(X0)) then
            p = size(X0)
            ! Initialize.
            call copy(X(:p), X0)
            ! Orthonormalize.
            call orthonormalize_basis(X(:p))
        endif
    end procedure initialize_krylov_subspace_${type[0]}$${kind}$
    #:endfor

    !-------------------------------------------------------
    !-----     Initialize random orthonormal basis     -----
    !-------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure initialize_random_orthonormal_basis_${type[0]}$${kind}$
        integer :: p

        ! Fill with random data
        call rand_basis(X)

        ! Orthonormalize
        call orthonormalize_basis(X)
    end procedure initialize_random_orthonormal_basis_${type[0]}$${kind}$
    #:endfor

    !----------------------------------------
    !-----     Orthonormalize basis     -----
    !----------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure orthonormalize_basis_${type[0]}$${kind}$
        character(len=*), parameter :: this_procedure = 'orthonormalize_basis_${type[0]}$${kind}$'
        ${type}$ :: R(size(X),size(X))
        integer :: info

        if (time_lightkrylov()) call timer%start(this_procedure)
        ! internals
        call qr(X, R, info)
        call check_info(info, 'qr', this_module, this_procedure)
        if (time_lightkrylov()) call timer%stop(this_procedure)
    end procedure orthonormalize_basis_${type[0]}$${kind}$

    #:endfor
    !---------------------------------------------------
    !-----     Check orthonormality of a basis     -----
    !---------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure is_orthonormal_${type[0]}$${kind}$
        ${type}$, dimension(size(X), size(X)) :: G
        ortho = .true.
        G = Gram(X)
        if (mnorm(G - eye(size(X)), "Fro") > rtol_sp) then
            ! The basis is not orthonormal.
            ortho = .false.
        end if
    end procedure is_orthonormal_${type[0]}$${kind}$

    #:endfor
    !----------------------------------------------
    !-----     Biorthonormalize two bases     -----
    !----------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    module procedure biorthonormalize_bases_${type[0]}$${kind}$
        character(len=*), parameter :: this_procedure = 'biorthonormalize_bases_${type[0]}$${kind}$'
        !! SVD workspace
        integer  :: n, info_, nretain
        ${type}$, allocatable  :: M(:,:), U(:,:), VT(:,:)
        real(${kind}$), allocatable :: S(:)
        real(${kind}$) :: tol_

        if (time_lightkrylov()) call timer%start(this_procedure)

        ! Check sizes.
        if (size(X) /= size(Y)) then
            call stop_error("Krylov bases X and Y have different sizes.", &
                              & this_module, this_procedure)
        endif

        ! handle optional tol
        tol_ = optval(tol, atol_${kind}$)
        n = size(X)
        
        ! compute SVD of inner product matrix
        M = innerprod(Y, X)
        allocate(S(n), U(n, n), VT(n, n))
        call svd(M, S, U, VT)

        ! count + renormalize retained singular values; zero the rest
        nretain = count(S / S(1) > tol_)
        call check_info(merge(-1, 0, nretain == 0), 'biorthonormalize_bases', &
            & this_module, this_procedure)
        S(:nretain) = one_r${kind}$ / sqrt(S(:nretain))
        S(nretain+1:) = zero_r${kind}$

        ! apply symmetric transformation in-place
        block
            class(abstract_vector_${type[0]}$${kind}$), allocatable, target :: wloc(:)
            class(abstract_vector_${type[0]}$${kind}$), pointer :: Xwrk(:)
            integer :: iostat
            character(len=100) :: errmsg

            ! One work basis, reused for both projections: user-provided, or allocated here
            ! and released once.
            if (present(work)) then
                call prepare_workspace(work, nretain, X(1), this_module, this_procedure)
                Xwrk => work(1:nretain)
            else
                allocate(wloc(nretain), mold=X(1), stat=iostat, errmsg=errmsg)
                call check_allocation(iostat, errmsg, this_module, this_procedure)
                call init_like_basis(wloc, X(1))
                Xwrk => wloc
            endif

            #:if type[0] == "r"
            call linear_combination(Xwrk, X, matmul(transpose(VT(:nretain, :)), diag(S(:nretain))))
            #:else
            call linear_combination(Xwrk, X, matmul(hermitian(VT(:nretain, :)), diag(S(:nretain))))
            #:endif
            call copy(X(:nretain), Xwrk)
            call zero_basis(X(nretain+1:))
            call linear_combination(Xwrk, Y, matmul(U(:, :nretain), diag(S(:nretain))))
            call copy(Y(:nretain), Xwrk)
            call zero_basis(Y(nretain+1:))

            if (.not. present(work)) call free_basis(wloc)
            nullify(Xwrk)
        end block

        if (present(info)) info = nretain
        if (time_lightkrylov()) call timer%stop(this_procedure)

    end procedure biorthonormalize_bases_${type[0]}$${kind}$

    #:endfor
end submodule krylov_utilities