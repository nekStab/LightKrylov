#:include "../../include/common.fypp"
#:set RC_KINDS_TYPES = REAL_KINDS_TYPES + CMPLX_KINDS_TYPES
module LightKrylov_ExpmLib
    !!  This module implements the evaluation of the "matrix-exponential times vector" procedure
    !!  using Krylov methods.
    !!
    !!  - `kexpm` computes \( \exp(\tau \mathbf{A}) \mathbf{b} \) (or its block version) by projection
    !!    onto a single (block) Krylov subspace whose dimension is increased until the error estimate
    !!    drops below the user-defined tolerance.
    !!  - `kexpm_substep` splits the time horizon into adaptively chosen sub-steps (Expokit-like) so
    !!    that convergence no longer depends on \( \| \tau \mathbf{A} \| \) being small enough for a
    !!    fixed Krylov dimension. With a persistent metadata object it learns, over successive calls,
    !!    the cheapest number of uniform sub-steps (warm start) while keeping the error check.
    !!  - `krylov_exptA` is a wrapper of `kexpm_substep` conforming to the `abstract_exptA` interface.

    ! Fortran standard library.
    use stdlib_optval, only: optval
    use stdlib_linalg, only: mnorm, matrix_exp

    ! LightKrylov.
    use LightKrylov_Constants
    use LightKrylov_Logger
    use LightKrylov_Utils
    use LightKrylov_AbstractVectors
    use LightKrylov_AbstractLinops
    use LightKrylov_BaseKrylov
    use LightKrylov_Timing, only: timer => global_lightkrylov_timer, time_lightkrylov

    implicit none(type, external)
    private

    character(len=*), parameter :: this_module      = 'LK_ExpmLib'
    character(len=*), parameter :: this_module_long = 'LightKrylov_ExpmLib'

    integer, parameter :: kmax = 100
    !! Default maximum number of Arnoldi steps in `kexpm`.

    #:for kind, type in RC_KINDS_TYPES
    public :: abstract_exptA_${type[0]}$${kind}$
    #:endfor
    public :: kexpm
    public :: kexpm_substep
    public :: krylov_exptA
    #:for kind, type in RC_KINDS_TYPES
    public :: krylov_exptA_${type[0]}$${kind}$
    #:endfor

    !-----------------------------------------------------------
    !-----     Options and metadata for `kexpm_substep`     -----
    !-----------------------------------------------------------

    #:for kind in REAL_KINDS
    type, extends(abstract_opts), public :: kexpm_${kind}$_opts
        !! Options for the sub-stepped Krylov exponential `kexpm_substep`.
        integer :: kdim = 30
        !! Maximum number of Krylov vectors per sub-step (default: 30).
        logical :: warm_start = .true.
        !! Re-use the sub-step count learned during previous calls (stored in the metadata).
        !! Only active when a `kexpm_${kind}$_metadata` object is passed (default: .true.).
        logical :: tune = .true.
        !! Over successive calls, decrease the number of uniform sub-steps while this lowers the
        !! number of matrix-vector products, and freeze it at the last setting that did not need
        !! the safety net (default: .true.). With `.false.`, the count of the cold call is kept.
        integer :: max_rejections = 25
        !! Maximum number of consecutive step-size reductions within one sub-step (default: 25).
        integer :: max_substeps = 10000
        !! Safeguard on the number of sub-steps per call (default: 10000).
        logical :: if_print_metadata = .false.
        !! Print the metadata on exit (default: .false.).
    end type kexpm_${kind}$_opts

    type, extends(abstract_metadata), public :: kexpm_${kind}$_metadata
        !! Counters and learned settings of `kexpm_substep`. Pass the same object to successive calls
        !! to benefit from the warm start. `reset()` clears the counters only, `forget()` clears the
        !! learned settings (the next call is then a cold, fully adaptive one).
        ! ----- Counters -----
        integer :: n_calls = 0
        !! Number of calls.
        integer :: n_matvec = 0
        !! Total number of matrix-vector products.
        integer :: n_substeps = 0
        !! Total number of sub-steps.
        integer :: n_rejections = 0
        !! Total number of rejected step sizes (each costs one small dense exponential).
        integer :: n_fallbacks = 0
        !! Number of calls in which the learned uniform step was too large (safety net triggered).
        integer :: info = 0
        !! Information flag of the last call.
        logical :: converged = .false.
        !! Convergence flag of the last call.
        ! ----- Learned settings (warm start) -----
        logical :: learned = .false.
        !! Whether settings have been learned.
        integer :: nsub = 0
        !! Number of uniform sub-steps used by the next call (0: fully adaptive).
        integer :: nsub_best = 0
        !! Best number of uniform sub-steps found so far (0: adaptive was best).
        integer :: mv_best = 0
        !! Matrix-vector products of the best setting.
        integer :: nsub0 = 0
        !! Number of sub-steps taken by the cold adaptive call (starting point of the search).
        logical :: frozen = .false.
        !! Whether the search is over.
        real(${kind}$) :: tau_learned = 0.0_${kind}$
        real(${kind}$) :: tol_learned = 0.0_${kind}$
        integer :: kdim_learned = 0
        !! Problem settings for which the learned values are valid: |tau|, tol/||b|| (within a
        !! factor 2) and kdim. Any change triggers `forget`.
    contains
        procedure, pass(self), public :: print => print_kexpm_${kind}$
        procedure, pass(self), public :: reset => reset_kexpm_${kind}$
        procedure, pass(self), public :: forget => forget_kexpm_${kind}$
    end type kexpm_${kind}$_metadata

    #:endfor

    !--------------------------------------------------------
    !-----     Reusable workspace (Krylov basis, H, E)     -----
    !--------------------------------------------------------

    #:for kind, type in RC_KINDS_TYPES
    type, public :: kexpm_workspace_${type[0]}$${kind}$
        !! Reusable workspace for `kexpm` and `kexpm_substep`: the Krylov basis `X`, the Hessenberg
        !! matrix `H` and the dense exponential `E`. Pass the same object (`work=`) to successive
        !! calls: it is allocated on first use and only re-allocated when it is too small, or when
        !! the type or size of the vectors changes. Call `free()` to release the memory.
        private
        class(abstract_vector_${type[0]}$${kind}$), allocatable :: X(:)
        ${type}$, allocatable :: H(:, :)
        ${type}$, allocatable :: Ebuf(:)
        !! Contiguous storage for the dense exponential (n x n, column-major), so that stdlib's
        !! `matrix_exp` never needs a temporary copy of a non-contiguous section.
    contains
        procedure, pass(self), public :: free => free_kexpm_workspace_${type[0]}$${kind}$
    end type kexpm_workspace_${type[0]}$${kind}$

    #:endfor

    abstract interface
        #:for kind, type in RC_KINDS_TYPES
        subroutine abstract_exptA_${type[0]}$${kind}$(vec_out, A, vec_in, tau, info, trans)
            !! Abstract interface to define the matrix exponential-vector product.
            import ${kind}$
            import abstract_vector_${type[0]}$${kind}$
            import abstract_linop_${type[0]}$${kind}$
            implicit none(type, external)
            class(abstract_vector_${type[0]}$${kind}$), intent(out) :: vec_out
            !! Solution vector.
            class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
            !! Linear operator to be exponentiated.
            class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec_in
            !! Input vector.
            real(${kind}$), intent(in) :: tau
            !! Time horizon for integration.
            integer, intent(out) :: info
            !! Information flag.
            logical, optional, intent(in) :: trans
            !! Use transpose ?
        end subroutine abstract_exptA_${type[0]}$${kind}$

        #:endfor
    end interface

    interface kexpm
        !!  ### Description
        !!
        !!  This interface provides methods to evaluate the matrix-vector product
        !!  \( c = \exp(\tau A) b \) based on the Arnoldi method.
        !!
        !!  ### Syntax
        !!
        !!  ```fortran
        !!      call kexpm(c, A, b, tau, tol, info [, trans] [, kdim] [, X] [, work])
        !!  ```
        !!
        !!  ### Arguments
        !!
        !!  - `c`   :   Output vector (or vectors). It is an `intent(out)` argument.
        !!
        !!  - `A`   :   Linear operator to be exponentiated. It is an `intent(inout)` argument.
        !!
        !!  - `b`   :   Vector (or vectors) to be multiplied by \( \exp(\tau A) \). It is an `intent(in)` argument.
        !!
        !!  - `tau` :   `real` (single or double) time over which the matrix exponential needs to
        !!              be computed. It is an `intent(in)` argument.
        !!
        !!  - `tol` :   Absolute tolerance on the (conservative) error estimate.
        !!
        !!  - `info`    :   `integer` Information flag. On exit:
        !!                  - `info > 0`  : converged, number of Krylov vectors used.
        !!                  - `info = -1` : the error estimate did not drop below `tol` within the
        !!                                  allowed Krylov dimension.
        !!                  - `info = -3` : invalid workspace `X` (fewer than `2p` vectors, or not a
        !!                                  multiple of the block size `p`).
        !!                  - `info = -4` : `kdim < 1`.
        !!                  - `info = -5` : `tol < 0`.
        !!                  - `info = -6` : empty `B`, or `size(C) /= size(B)` (block version).
        !!                  For invalid inputs (`info <= -3`) nothing is computed.
        !!
        !!  - `trans` (optional)    :   Whether \( A \) or \( A^H \) is being used.
        !!                              (default `trans=.false.`)
        !!
        !!  - `kdim` (optional)     :   Maximum number of (block) Arnoldi steps (default 100). The Krylov
        !!                              basis then holds `p*(kdim+1)` vectors, `p` being the block size.
        !!
        !!  - `X` (optional)        :   Pre-allocated workspace for the Krylov basis. Its size must be a
        !!                              multiple of the block size `p` and at least `2p`. When present,
        !!                              no Krylov vector is allocated and the number of steps is
        !!                              `min(kdim, size(X)/p - 1)`. On exit it contains the Krylov basis.
        !!
        !!  - `work` (optional)     :   `kexpm_workspace_*` object re-used between calls. It holds the
        !!                              Krylov basis (unless `X` is given), the Hessenberg matrix and the
        !!                              dense exponential: after the first call, no memory is allocated.
        #:for kind, type in RC_KINDS_TYPES
        module procedure kexpm_vec_${type[0]}$${kind}$
        module procedure kexpm_mat_${type[0]}$${kind}$
        #:endfor
    end interface

    interface kexpm_substep
        !!  ### Description
        !!
        !!  Evaluates \( c = \exp(\tau A) b \) as a product of sub-steps \( \exp(\Delta t_j A) \).
        !!  Each sub-step grows a Krylov basis of at most `opts%kdim` vectors until the error estimate
        !!  is below `tol * dt / |tau|`. When the basis is exhausted, `dt` is reduced using the
        !!  Hessenberg matrix already computed (no extra matrix-vector product).
        !!
        !!  **Warm start.** When the same `kexpm_*_metadata` object is passed to successive calls with
        !!  the same `|tau|`, `kdim` and relative tolerance `tol/||b||` (within a factor 2), the first call is fully adaptive and records the number
        !!  of sub-steps. Later calls use *uniform* sub-steps and, with `opts%tune`, reduce their
        !!  number by one per call while this lowers the cost, then freeze it. The error check is
        !!  always kept: if a learned step is too large, the rest of that call falls back to the
        !!  adaptive controller (the result stays within tolerance), and a frozen count is raised
        !!  and re-tuned.
        !!  Call `meta%forget()` if the operator, the horizon or the tolerance change substantially.
        !!
        !!  ### Syntax
        !!
        !!  ```fortran
        !!      call kexpm_substep(c, A, b, tau, tol, info [, trans] [, options] [, meta] [, work])
        !!      call kexpm_substep(C, A, B, tau, tol, info [, trans] [, options] [, meta] [, work])
        !!  ```
        !!
        !!  **Basis version.** For `B(:)`, each column is propagated by the single-vector algorithm,
        !!  in order, sharing one workspace and one metadata object. The sub-step count learned on the
        !!  first columns is re-used by the following ones and by later calls; `meta%n_calls` counts
        !!  columns. Columns are treated separately rather than with block Arnoldi on purpose: the
        !!  linear operator is applied one vector at a time, so a block Krylov basis needs the same
        !!  number of matvecs but p times more orthogonalization (and its running block would
        !!  eventually become rank deficient, which block Arnoldi cannot handle without deflation).
        !!
        !!  ### Arguments
        !!
        !!  - `c` / `C(:)`  :   Output vector(s). `intent(out)`.
        !!  - `A`       :   Linear operator to be exponentiated. `intent(inout)`.
        !!  - `b` / `B(:)`  :   Input vector(s). `intent(in)`. For the basis version, `tol` applies to
        !!                      each column.
        !!  - `tau`     :   Time horizon (may be negative). `intent(in)`.
        !!  - `tol`     :   Absolute tolerance on the accumulated error estimate. `intent(in)`.
        !!  - `info`    :   Total number of matrix-vector products on success, -1 if not converged,
        !!                  -4 if `opts%kdim < 1`, -5 if `tol < 0`, -7 if `opts%max_rejections < 1`
        !!                  or `opts%max_substeps < 1` (nothing is computed for invalid inputs).
        !!                  Basis version: total over the columns on success, -6 if `B` is empty or
        !!                  `size(C) /= size(B)`; on failure, the code of the first failing column is
        !!                  returned and the following columns are not computed.
        !!  - `trans` (optional)   :   Use \( A^H \) instead of \( A \) (default `.false.`).
        !!  - `options` (optional) :   `kexpm_sp_opts` / `kexpm_dp_opts`.
        !!  - `meta` (optional)    :   `kexpm_sp_metadata` / `kexpm_dp_metadata`, `intent(inout)`:
        !!                             counters and learned settings, kept between calls.
        !!  - `work` (optional)    :   `kexpm_workspace_*` object re-used between calls (Krylov basis,
        !!                             H and E): after the first call, no memory is allocated.
        #:for kind, type in RC_KINDS_TYPES
        module procedure kexpm_substep_vec_${type[0]}$${kind}$
        module procedure kexpm_substep_mat_${type[0]}$${kind}$
        #:endfor
    end interface

    interface krylov_exptA
        !!  ### Description
        !!
        !!  Utility function to evaluate the matrix-exponential times vector. The time horizon is split
        !!  into adaptively chosen sub-steps (step-size control based on the Krylov error estimate,
        !!  in the spirit of Sidje's Expokit `expv`), each one built from a Krylov basis of at most
        !!  30 vectors. Rejected step sizes only cost a small dense exponential, never extra
        !!  matrix-vector products.
        !!
        !!  ### Syntax
        !!
        !!  ```fortran
        !!      call krylov_exptA(vec_out, A, vec_in, tau, info, trans)
        !!  ```
        !!
        !!  ### Arguments
        !!
        !!  - `vec_out` :   Output vector.
        !!
        !!  - `A`       :   Matrix to be exponentiated.
        !!
        !!  - `vec_in`  :   Input vector.
        !!
        !!  - `tau`     :   Integration time.
        !!
        !!  - `info`    :   Information flag (total number of matrix-vector products on success).
        !!
        !!  - `trans`   :   Whether \( A \) or \( A^H \) is being used.
        #:for kind, type in RC_KINDS_TYPES
        module procedure krylov_exptA_${type[0]}$${kind}$
        #:endfor
    end interface

contains
    #:for kind, type in RC_KINDS_TYPES
    !-------------------------------------------------------------------
    !-----     Public driver : single vector, fixed time horizon     -----
    !-------------------------------------------------------------------

    subroutine kexpm_vec_${type[0]}$${kind}$(c, A, b, tau, tol, info, trans, kdim, X, work)
        !! Best approximation of \( \exp(\tau \mathbf{A}) \mathbf{b} \) in the computed Krylov subspace
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: c
        !! Output vector.
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        !! Linear operator to be exponentiated.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        !! Input vector on which to apply \( \exp(\tau \mathbf{A}) \).
        real(${kind}$), intent(in) :: tau
        !! Time horizon for the exponentiation.
        real(${kind}$), intent(in) :: tol
        !! Solution tolerance based on error estimates.
        integer, intent(out) :: info
        !! Information flag.
        logical, optional, intent(in) :: trans
        !! Use transpose?
        integer, optional, intent(in) :: kdim
        !! Maximum number of Arnoldi steps.
        class(abstract_vector_${type[0]}$${kind}$), optional, intent(inout) :: X(:)
        !! Optional user-supplied Krylov basis (takes precedence over the one in `work`).
        type(kexpm_workspace_${type[0]}$${kind}$), optional, intent(inout) :: work
        !! Optional reusable workspace (basis, H, E): no allocation after the first call.

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_vec_${type[0]}$${kind}$'
        type(kexpm_workspace_${type[0]}$${kind}$) :: wloc
        integer :: nsteps

        ! Sanity checks (no work is done for invalid inputs).
        info = 0
        if (present(X)) then
            if (size(X) < 2) info = -3
        endif
        if (info == 0 .and. present(kdim)) then
            if (kdim < 1) info = -4
        endif
        if (info == 0 .and. tol < 0.0_${kind}$) info = -5
        if (info /= 0) then
            call log_kexpm_invalid_input(info, this_procedure)
            return
        endif

        if (time_lightkrylov()) call timer%start(this_procedure)

        if (present(X)) then
            nsteps = min(optval(kdim, size(X)-1), size(X)-1)
        else
            nsteps = optval(kdim, kmax)
        endif

        if (present(work)) then
            call kexpm_vec_dispatch_${type[0]}$${kind}$(c, A, b, tau, tol, info, optval(trans, .false.), nsteps+1, work, X)
        else
            ! Local workspace: deallocated automatically on return.
            call kexpm_vec_dispatch_${type[0]}$${kind}$(c, A, b, tau, tol, info, optval(trans, .false.), nsteps+1, wloc, X)
        endif

        if (time_lightkrylov()) call timer%stop(this_procedure)
    end subroutine kexpm_vec_${type[0]}$${kind}$

    subroutine kexpm_vec_dispatch_${type[0]}$${kind}$(c, A, b, tau, tol, info, transpose, nvec, work, X)
        !! Selects the Krylov basis (user `X` or workspace) and sizes the workspace.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: c
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        real(${kind}$), intent(in) :: tau, tol
        integer, intent(out) :: info
        logical, intent(in) :: transpose
        integer, intent(in) :: nvec
        type(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: work
        class(abstract_vector_${type[0]}$${kind}$), optional, intent(inout) :: X(:)

        call ensure_dense_${type[0]}$${kind}$(work, nvec)
        if (present(X)) then
            call kexpm_vec_kernel_${type[0]}$${kind}$(c, A, b, tau, tol, info, transpose, X(:nvec), work%H, work%Ebuf)
        else
            call ensure_basis_${type[0]}$${kind}$(work, nvec, b)
            call kexpm_vec_kernel_${type[0]}$${kind}$(c, A, b, tau, tol, info, transpose, work%X(:nvec), work%H, work%Ebuf)
        endif
    end subroutine kexpm_vec_dispatch_${type[0]}$${kind}$

    subroutine kexpm_vec_kernel_${type[0]}$${kind}$(c, A, b, tau, tol, info, transpose, X, H, Ebuf)
        !! Worker for `kexpm_vec`. No allocation: X, H and Ebuf are provided by the caller.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: c
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        real(${kind}$), intent(in) :: tau, tol
        integer, intent(out) :: info
        logical, intent(in) :: transpose
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X(:)
        ${type}$, intent(inout) :: H(:, :)
        ${type}$, intent(inout), target, contiguous :: Ebuf(:)

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_vec_${type[0]}$${kind}$'
        real(${kind}$) :: beta, err_est
        integer :: kp, ksteps
        logical :: breakdown
        character(len=256) :: msg

        beta = b%norm()
        if (beta == 0.0_${kind}$) then
            ! Input is zero => Output is zero. `copy` (not `zero`): c is intent(out), its components
            ! are reset on entry and must not be relied upon (e.g. the size of a dense_vector).
            call copy(c, b)
            info = 1
            call log_information('Zero input vector, zero output.', this_module, this_procedure)
            return
        endif

        ! Initialize the Krylov subspace with the normalized input vector. Only X(1) is set:
        ! every other basis vector is overwritten by the matrix-vector product before being used.
        call X(1)%zero() ; call X(1)%axpby(one_${type[0]}$${kind}$ / beta, b, one_${type[0]}$${kind}$)

        ! Grow the Krylov subspace until the error estimate is below tol.
        call arnoldi_expm_${type[0]}$${kind}$(A, X, H, Ebuf, beta, tau, tol, transpose, &
                                              & ksteps, kp, err_est, breakdown)

        ! Single projection back onto the full space: c = beta * X(:kp) @ E(:kp, 1).
        call project_${type[0]}$${kind}$(c, X(:kp), Ebuf(:kp), beta)

        if (err_est <= tol) then
            info = kp
            write(msg,'(A,I0,2(A,E9.2),A,L1)') 'Converged. kp= ', kp, ', err_est= ', err_est, &
                                             & ', tol= ', tol, ', breakdown= ', breakdown
            call log_information(msg, this_module, this_procedure)
        else
            info = -1
            write(msg,'(A,I0,2(A,E9.2))') 'Not converged. kp= ', kp, ', err_est= ', err_est, ', tol= ', tol
            call log_information(msg, this_module, this_procedure)
        endif
    end subroutine kexpm_vec_kernel_${type[0]}$${kind}$

    !----------------------------------------------------------------
    !-----     Public driver : block version, fixed horizon     -----
    !----------------------------------------------------------------

    subroutine kexpm_mat_${type[0]}$${kind}$(C, A, B, tau, tol, info, trans, kdim, X, work)
        !! Best Krylov approximation of \( \mathbf{C} = \exp(\tau \mathbf{A}) \mathbf{B} \) in the computed Krylov subspace.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: C(:)
        !! Output vectors.
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        !! Linear operator to be exponentiated.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: B(:)
        !! Input matrix on which to apply \( \exp(\tau \mathbf{A}) \).
        real(${kind}$), intent(in) :: tau
        !! Time horizon for the exponentiation.
        real(${kind}$), intent(in) :: tol
        !! Solution tolerance based on error estimates.
        integer, intent(out) :: info
        !! Information flag.
        logical, optional, intent(in) :: trans
        !! Use transpose ?
        integer, optional, intent(in) :: kdim
        !! Maximum number of block-Arnoldi steps.
        class(abstract_vector_${type[0]}$${kind}$), optional, intent(inout) :: X(:)
        !! Optional user-supplied block Krylov basis (size multiple of size(B)).
        type(kexpm_workspace_${type[0]}$${kind}$), optional, intent(inout) :: work
        !! Optional reusable workspace (basis, H, E): no allocation after the first call.

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_mat_${type[0]}$${kind}$'
        type(kexpm_workspace_${type[0]}$${kind}$) :: wloc
        integer :: p, nsteps

        p = size(B)

        ! Sanity checks (no work is done for invalid inputs).
        info = 0
        if (p < 1 .or. size(C) /= p) then
            info = -6
        else if (present(X)) then
            if (mod(size(X), p) /= 0 .or. size(X) < 2*p) info = -3
        endif
        if (info == 0 .and. present(kdim)) then
            if (kdim < 1) info = -4
        endif
        if (info == 0 .and. tol < 0.0_${kind}$) info = -5
        if (info /= 0) then
            call log_kexpm_invalid_input(info, this_procedure)
            return
        endif

        if (time_lightkrylov()) call timer%start(this_procedure)

        ! NOTE: kdim counts block steps. The basis holds p*(kdim+1) vectors.
        if (present(X)) then
            nsteps = min(optval(kdim, size(X)/p - 1), size(X)/p - 1)
        else
            nsteps = optval(kdim, kmax)
        endif

        if (present(work)) then
            call kexpm_mat_dispatch_${type[0]}$${kind}$(C, A, B, tau, tol, info, optval(trans, .false.), p*(nsteps+1), work, X)
        else
            call kexpm_mat_dispatch_${type[0]}$${kind}$(C, A, B, tau, tol, info, optval(trans, .false.), p*(nsteps+1), wloc, X)
        endif

        if (time_lightkrylov()) call timer%stop(this_procedure)
    end subroutine kexpm_mat_${type[0]}$${kind}$

    subroutine kexpm_mat_dispatch_${type[0]}$${kind}$(C, A, B, tau, tol, info, transpose, nvec, work, X)
        !! Selects the block Krylov basis (user `X` or workspace) and sizes the workspace.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: C(:)
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: B(:)
        real(${kind}$), intent(in) :: tau, tol
        integer, intent(out) :: info
        logical, intent(in) :: transpose
        integer, intent(in) :: nvec
        type(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: work
        class(abstract_vector_${type[0]}$${kind}$), optional, intent(inout) :: X(:)

        call ensure_dense_${type[0]}$${kind}$(work, nvec)
        if (present(X)) then
            call kexpm_mat_kernel_${type[0]}$${kind}$(C, A, B, tau, tol, info, transpose, X(:nvec), work%H, work%Ebuf)
        else
            call ensure_basis_${type[0]}$${kind}$(work, nvec, B(1))
            call kexpm_mat_kernel_${type[0]}$${kind}$(C, A, B, tau, tol, info, transpose, work%X(:nvec), work%H, work%Ebuf)
        endif
    end subroutine kexpm_mat_dispatch_${type[0]}$${kind}$

    subroutine kexpm_mat_kernel_${type[0]}$${kind}$(C, A, B, tau, tol, info, transpose, X, H, Ebuf)
        !! Worker for `kexpm_mat`. The basis X, H and Ebuf are provided by the caller.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: C(:)
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: B(:)
        real(${kind}$), intent(in) :: tau, tol
        integer, intent(out) :: info
        logical, intent(in) :: transpose
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X(:)
        ${type}$, intent(inout) :: H(:, :)
        ${type}$, intent(inout), target, contiguous :: Ebuf(:)

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_mat_${type[0]}$${kind}$'
        ${type}$ :: R(size(B), size(B))
        ${type}$, pointer, contiguous :: E(:, :)
        integer :: perm(size(B))
        real(${kind}$) :: err_est
        integer :: p, nk, k, kpm, kp, kpp, i
        logical :: breakdown, partial_breakdown
        character(len=256) :: msg

        p  = size(B)
        nk = size(X)/p - 1
        R = zero_${type[0]}$${kind}$ ; perm = 0

        ! Orthonormalize the input block directly inside the Krylov basis: B = X(:p) @ R.
        ! Only X(:p) is set: the other basis vectors are overwritten by the matvecs before use.
        do i = 1, p
            call X(i)%zero() ; call X(i)%axpby(one_${type[0]}$${kind}$, B(i), one_${type[0]}$${kind}$)
        enddo
        call qr(X(:p), R, perm, info)
        call check_info(info, 'qr_pivot', this_module, this_procedure)
        call permcols(R, invperm(perm))

        if (mnorm(R, "fro") == 0.0_${kind}$) then
            ! Input matrix is zero (C is intent(out): rebuilt from B rather than zeroed in place).
            call copy(C, B)
            info = p
            call log_information('Zero input block, zero output.', this_module, this_procedure)
            return
        endif

        err_est = huge(1.0_${kind}$) ; kp = p ; kpp = p
        breakdown = .false. ; partial_breakdown = .false.

        expm_arnoldi: do k = 1, nk
            ! Set counters.
            kpm = (k-1)*p ; kp = kpm + p ; kpp = kp + p

            ! Compute the k-th step of the block Arnoldi factorization.
            call arnoldi(A, X, H, info, kstart=k, kend=k, transpose=transpose, blksize=p)
            call check_info(info, 'arnoldi', this_module, this_procedure)

            if (info == kp) then
                ! Block Arnoldi reports breakdown as soon as the new block is rank deficient.
                ! The subspace is invariant only if the whole coupling block vanishes.
                breakdown = mnorm(H(kp+1:kpp, kpm+1:kp), "fro") < atol_${kind}$
                ! Otherwise, the QR completed the block with random vectors that are not
                ! orthogonal to the previous basis: we cannot safely continue (no deflation).
                partial_breakdown = .not. breakdown
            endif

            if (breakdown) then
                ! Exact invariant subspace: do not consider the extended matrix.
                kpp = kp
                call small_expm_${type[0]}$${kind}$(Ebuf, H, kpp, kpp, tau)
                E(1:kpp, 1:kpp) => Ebuf(1:kpp*kpp)
                err_est = 0.0_${kind}$
                exit expm_arnoldi
            endif

            ! Dense exponential of the extended block-Hessenberg matrix.
            call small_expm_${type[0]}$${kind}$(Ebuf, H, kpp, kp, tau)
            E(1:kpp, 1:kpp) => Ebuf(1:kpp*kpp)

            ! Cheap (conservative) error estimate.
            err_est = mnorm(matmul(E(kp+1:kpp, :p), R), "fro")

            if (err_est <= tol .or. partial_breakdown) exit expm_arnoldi
        enddo expm_arnoldi

        ! Single projection back to the full space: C = X(:kpp) @ (E(:kpp, :p) @ R).
        call project_block_${type[0]}$${kind}$(C, X(:kpp), matmul(E(:kpp, :p), R))

        if (err_est <= tol) then
            info = kpp
            write(msg,'(A,I0,2(A,E9.2),A,L1)') 'Converged. kp= ', kpp, ', err_est= ', err_est, &
                                             & ', tol= ', tol, ', breakdown= ', breakdown
            call log_information(msg, this_module, this_procedure)
        else
            info = -1
            if (partial_breakdown) then
                write(msg,'(A,I0,2(A,E9.2))') 'Not converged (partial block breakdown, deflation not supported). kp= ', &
                                            & kpp, ', err_est= ', err_est, ', tol= ', tol
            else
                write(msg,'(A,I0,2(A,E9.2))') 'Not converged. kp= ', kpp, ', err_est= ', err_est, ', tol= ', tol
            endif
            call log_information(msg, this_module, this_procedure)
        endif
    end subroutine kexpm_mat_kernel_${type[0]}$${kind}$

    !--------------------------------------------------------------------
    !-----     Public driver : adaptive sub-stepping (Expokit-like)     -----
    !--------------------------------------------------------------------

    subroutine krylov_exptA_${type[0]}$${kind}$(vec_out, A, vec_in, tau, info, trans)
        !! Wrapper for the Krylov-based evaluation of the action of the matrix exponential operator
        !! on a vector that conforms to the `abstract_exptA_${type[0]}$${kind}$` interface.
        !! It uses `kexpm_substep` with default options and no warm start; call `kexpm_substep`
        !! directly with a persistent metadata object to re-use learned settings.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: vec_out
        !! Solution vector.
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        !! Linear operator to be exponentiated.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: vec_in
        !! Input vector to be multiplied by \( \exp(\tau \mathbf{A}) \).
        real(${kind}$), intent(in) :: tau
        !! Time horizon for the exponentiation.
        integer, intent(out) :: info
        !! Information flag.
        logical, optional, intent(in) :: trans
        !! Use adjoint ?

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'krylov_exptA_${type[0]}$${kind}$'
        real(${kind}$) :: tol

        if (time_lightkrylov()) call timer%start(this_procedure)

        ! Tolerance relative to the norm of the input (identical to the former atol for unit vectors).
        tol = atol_${kind}$ * vec_in%norm()

        call kexpm_substep_vec_${type[0]}$${kind}$(vec_out, A, vec_in, tau, tol, info, trans=trans)

        if (time_lightkrylov()) call timer%stop(this_procedure)
        call check_info(info, 'kexpm', this_module, this_procedure)
    end subroutine krylov_exptA_${type[0]}$${kind}$

    subroutine kexpm_substep_vec_${type[0]}$${kind}$(c, A, b, tau, tol, info, trans, options, meta, work)
        !! Sub-stepped Krylov approximation of \( \exp(\tau \mathbf{A}) \mathbf{b} \) with optional
        !! warm start and reusable workspace (see the `kexpm_substep` interface).
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: c
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        real(${kind}$), intent(in) :: tau, tol
        integer, intent(out) :: info
        logical, optional, intent(in) :: trans
        class(abstract_opts), optional, intent(in) :: options
        class(abstract_metadata), optional, intent(inout) :: meta
        type(kexpm_workspace_${type[0]}$${kind}$), optional, intent(inout) :: work
        !! Optional reusable workspace (basis, H, E): no allocation after the first call.
        character(len=*), parameter :: this_procedure = 'kexpm_substep_vec_${type[0]}$${kind}$'
        type(kexpm_workspace_${type[0]}$${kind}$) :: wloc

        ! Sanity checks before the timer starts (invalid calls are not timed, nothing is computed).
        call check_substep_inputs_${kind}$(tol, options, info, this_procedure)
        if (info /= 0) return

        if (time_lightkrylov()) call timer%start(this_procedure)
        if (present(work)) then
            call kexpm_substep_vec_impl_${type[0]}$${kind}$(c, A, b, tau, tol, info, work, trans, options, meta)
        else
            call kexpm_substep_vec_impl_${type[0]}$${kind}$(c, A, b, tau, tol, info, wloc, trans, options, meta)
        endif
        if (time_lightkrylov()) call timer%stop(this_procedure)
    end subroutine kexpm_substep_vec_${type[0]}$${kind}$

    subroutine kexpm_substep_mat_${type[0]}$${kind}$(C, A, B, tau, tol, info, trans, options, meta, work)
        !! Sub-stepped Krylov approximation of \( \mathbf{C} = \exp(\tau \mathbf{A}) \mathbf{B} \),
        !! column by column with a shared workspace and metadata (see the `kexpm_substep` interface).
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: C(:)
        !! Output vectors.
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        !! Linear operator to be exponentiated.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: B(:)
        !! Input vectors.
        real(${kind}$), intent(in) :: tau
        !! Time horizon (may be negative).
        real(${kind}$), intent(in) :: tol
        !! Absolute tolerance on the accumulated error estimate, for each column.
        integer, intent(out) :: info
        !! Total number of matvecs on success, error code of the first failing column otherwise.
        logical, optional, intent(in) :: trans
        !! Use adjoint?
        class(abstract_opts), optional, intent(in) :: options
        !! `kexpm_${kind}$_opts`.
        class(abstract_metadata), optional, intent(inout) :: meta
        !! `kexpm_${kind}$_metadata`, shared by all columns.
        type(kexpm_workspace_${type[0]}$${kind}$), optional, intent(inout) :: work
        !! Optional reusable workspace, shared by all columns.

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_substep_mat_${type[0]}$${kind}$'
        type(kexpm_workspace_${type[0]}$${kind}$) :: wloc
        integer :: j, info_j, nmatvec

        ! Sanity checks before the timer starts (invalid calls are not timed, nothing is computed).
        info = 0
        if (size(B) < 1 .or. size(C) /= size(B)) then
            info = -6
            call log_kexpm_invalid_input(info, this_procedure)
            return
        endif
        call check_substep_inputs_${kind}$(tol, options, info, this_procedure)
        if (info /= 0) return

        if (time_lightkrylov()) call timer%start(this_procedure)

        nmatvec = 0
        do j = 1, size(B)
            if (present(work)) then
                call kexpm_substep_vec_impl_${type[0]}$${kind}$(C(j), A, B(j), tau, tol, info_j, work, trans, options, meta)
            else
                ! One local workspace for all the columns.
                call kexpm_substep_vec_impl_${type[0]}$${kind}$(C(j), A, B(j), tau, tol, info_j, wloc, trans, options, meta)
            endif
            if (info_j < 0) then
                info = info_j
                exit
            endif
            nmatvec = nmatvec + info_j
        enddo
        if (info == 0) info = nmatvec

        if (time_lightkrylov()) call timer%stop(this_procedure)
    end subroutine kexpm_substep_mat_${type[0]}$${kind}$

    subroutine kexpm_substep_vec_impl_${type[0]}$${kind}$(c, A, b, tau, tol, info, work, trans, options, meta)
        !! Implementation of `kexpm_substep` (the workspace is always present here).
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(out) :: c
        !! Output vector.
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        !! Linear operator to be exponentiated.
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        !! Input vector.
        real(${kind}$), intent(in) :: tau
        !! Time horizon (may be negative).
        real(${kind}$), intent(in) :: tol
        !! Absolute tolerance on the accumulated error estimate.
        integer, intent(out) :: info
        !! Total number of matvecs on success, -1 otherwise.
        type(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: work
        !! Workspace (basis, H, E).
        logical, optional, intent(in) :: trans
        !! Use adjoint?
        class(abstract_opts), optional, intent(in) :: options
        !! `kexpm_${kind}$_opts`.
        class(abstract_metadata), optional, intent(inout) :: meta
        !! `kexpm_${kind}$_metadata` (counters and learned settings, kept between calls).

        ! ----- Internal variables -----
        character(len=*), parameter :: this_procedure = 'kexpm_substep_vec_${type[0]}$${kind}$'
        real(${kind}$), parameter :: safety = 0.9_${kind}$, fac_min = 0.2_${kind}$, fac_max = 5.0_${kind}$
        type(kexpm_${kind}$_opts) :: opts
        type(kexpm_${kind}$_metadata) :: lmeta
        real(${kind}$) :: t_end, sgn, t, dt, beta, err, tol_loc, fac, floor_tol, tol_rel
        integer :: m, ksteps, kp, nsub, nmatvec, nrej, nrej_tot, n_uniform
        logical :: transpose, breakdown, last, uniform, used_uniform, fallback
        character(len=256) :: msg

        ! ----- Options and metadata -----
        opts = kexpm_${kind}$_opts()
        if (present(options)) then
            select type (options)
            type is (kexpm_${kind}$_opts)
                opts = options
            class default
                call type_error('options', 'kexpm_${kind}$_opts', 'IN', this_module, this_procedure)
            end select
        endif
        if (present(meta)) then
            select type (meta)
            type is (kexpm_${kind}$_metadata)
                lmeta = meta
            class default
                call type_error('meta', 'kexpm_${kind}$_metadata', 'INOUT', this_module, this_procedure)
            end select
        endif

        ! Sanity checks (already done by the public drivers; kept so that the kernel is safe on its own).
        call check_substep_inputs_${kind}$(tol, options, info, this_procedure)
        if (info /= 0) return

        transpose = optval(trans, .false.)
        m = opts%kdim
        t_end = abs(tau) ; sgn = sign(1.0_${kind}$, tau)
        lmeta%n_calls = lmeta%n_calls + 1

        ! Learned settings are only valid for the same horizon, tolerance and Krylov dimension.
        ! The tolerance is compared relative to ||b|| (within a factor 2), so that calls with
        ! tol = rtol*||b|| and different right-hand sides share the learned settings.
        beta = b%norm()
        tol_rel = merge(tol/beta, 0.0_${kind}$, beta > 0.0_${kind}$)
        if (lmeta%learned) then
            if (abs(t_end - lmeta%tau_learned) > 10*epsilon(1.0_${kind}$)*t_end &
                & .or. tol_rel > 2*lmeta%tol_learned .or. 2*tol_rel < lmeta%tol_learned &
                & .or. m /= lmeta%kdim_learned) call lmeta%forget()
        endif
        used_uniform = present(meta) .and. opts%warm_start .and. lmeta%learned .and. lmeta%nsub > 0
        n_uniform = merge(lmeta%nsub, 0, used_uniform)
        uniform = used_uniform ; fallback = .false.

        ! c holds the running solution w(t).
        call copy(c, b)
        beta = c%norm()
        t = 0.0_${kind}$ ; nsub = 0 ; nmatvec = 0 ; nrej_tot = 0 ; info = 0

        if (beta /= 0.0_${kind}$ .and. t_end /= 0.0_${kind}$) then
            ! Workspace: re-used by every sub-step, and across calls when `work` is passed.
            call ensure_basis_${type[0]}$${kind}$(work, m+1, b)
            call ensure_dense_${type[0]}$${kind}$(work, m+1)

            dt = merge(t_end/max(n_uniform, 1), t_end, uniform)

            substeps: do while (t < t_end)
                nsub = nsub + 1
                if (nsub > opts%max_substeps) then
                    info = -1 ; exit substeps
                endif

                ! Last step (with a small slack so that round-off does not create a tiny extra step).
                last = (dt >= (t_end - t) - 10*epsilon(1.0_${kind}$)*t_end) ; if (last) dt = t_end - t

                beta = c%norm()
                if (beta == 0.0_${kind}$) exit substeps   ! Solution is exactly zero from now on.

                ! Roundoff floor on the local tolerance to avoid endless rejections.
                floor_tol = 2*epsilon(1.0_${kind}$)*beta
                tol_loc = max(tol*dt/t_end, floor_tol)

                ! Fresh Krylov basis started from the current solution. Only X(1) is set, and H needs
                ! no reset: Arnoldi rewrites every entry on or above the subdiagonal that is used.
                call work%X(1)%zero() ; call work%X(1)%axpby(one_${type[0]}$${kind}$ / beta, c, one_${type[0]}$${kind}$)

                call arnoldi_expm_${type[0]}$${kind}$(A, work%X(:m+1), work%H, work%Ebuf, beta, sgn*dt, tol_loc, transpose, &
                                                      & ksteps, kp, err, breakdown)
                nmatvec = nmatvec + ksteps

                if (breakdown) then
                    ! Invariant subspace: exact for any dt, finish the horizon in one go.
                    dt = t_end - t ; last = .true.
                    call small_expm_${type[0]}$${kind}$(work%Ebuf, work%H, kp, kp, sgn*dt)
                    err = 0.0_${kind}$
                else if (err > tol_loc) then
                    ! Krylov basis exhausted. Safety net: a learned uniform step that is too large
                    ! switches the rest of this call to the adaptive controller.
                    if (uniform) then
                        uniform = .false. ; fallback = .true.
                    endif
                    ! Shrink dt reusing H (only small dense exponentials).
                    last = .false.
                    do nrej = 1, opts%max_rejections
                        fac = min(safety, max(0.1_${kind}$, safety*(tol_loc/err)**(1.0_${kind}$/m)))
                        dt  = fac*dt
                        tol_loc = max(tol*dt/t_end, floor_tol)
                        call small_expm_${type[0]}$${kind}$(work%Ebuf, work%H, kp, ksteps, sgn*dt)
                        err = beta*abs(work%Ebuf(kp))
                        nrej_tot = nrej_tot + 1
                        if (err <= tol_loc) exit
                    enddo
                    if (err > tol_loc) then
                        info = -1 ; exit substeps
                    endif
                endif

                ! Advance: w(t+dt) = beta * X(:kp) @ E(:kp, 1).
                call project_${type[0]}$${kind}$(c, work%X(:kp), work%Ebuf(:kp), beta)
                if (last) then
                    t = t_end
                else
                    t = t + dt
                endif

                ! Next step size.
                if (uniform) then
                    dt = t_end/n_uniform
                else
                    ! Error controller (local error ~ dt^ksteps).
                    if (err > 0.0_${kind}$) then
                        fac = safety*(tol_loc/err)**(1.0_${kind}$/max(ksteps, 1))
                    else
                        fac = fac_max
                    endif
                    dt = dt*min(fac_max, max(fac_min, fac))
                endif
            enddo substeps
        endif

        if (info == 0) info = max(nmatvec, 1)

        ! ----- Update metadata (counters, learned settings) -----
        lmeta%n_matvec     = lmeta%n_matvec + nmatvec
        lmeta%n_substeps   = lmeta%n_substeps + nsub
        lmeta%n_rejections = lmeta%n_rejections + nrej_tot
        if (fallback) lmeta%n_fallbacks = lmeta%n_fallbacks + 1
        lmeta%info = info ; lmeta%converged = (info > 0)
        if (present(meta) .and. opts%warm_start .and. info > 0 .and. nsub > 0) then
            call learn_kexpm_${kind}$(lmeta, used_uniform, n_uniform, nsub, nmatvec, fallback, &
                                      & opts%tune, t_end, tol_rel, m)
        endif

        if (info > 0) then
            write(msg,'(A,I0,A,I0,A,I0,A,L1,A,L1)') 'Converged. substeps= ', nsub, ', matvecs= ', nmatvec, &
                & ', rejections= ', nrej_tot, ', warm start= ', used_uniform, ', fallback= ', fallback
        else
            write(msg,'(A,I0,A,E9.2,A,E9.2)') 'Not converged. substeps= ', nsub, ', t= ', sgn*t, ', tau= ', tau
        endif
        call log_information(msg, this_module, this_procedure)

        if (opts%if_print_metadata) call lmeta%print()
        if (present(meta)) then
            select type (meta)
            type is (kexpm_${kind}$_metadata)
                meta = lmeta
            end select
        endif
    end subroutine kexpm_substep_vec_impl_${type[0]}$${kind}$

    !----------------------------------------
    !-----     Private helper kernels     -----
    !----------------------------------------

    subroutine arnoldi_expm_${type[0]}$${kind}$(A, X, H, Ebuf, beta, tau, tol, transpose, ksteps, kp, err_est, breakdown)
        !! Grows the Arnoldi basis `X` (with `X(1)` already normalized) one vector at a time and
        !! evaluates the exponential of the extended Hessenberg matrix after each step, until
        !! `beta*|E(kp,1)| <= tol`, breakdown, or `size(X)-1` steps.
        !! On exit `Ebuf(1:kp*kp)` holds the kp x kp dense exponential (column-major), so that
        !! its first column is `Ebuf(1:kp)`.
        implicit none(type, external)
        class(abstract_linop_${type[0]}$${kind}$), intent(inout) :: A
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: X(:)
        ${type}$, intent(inout) :: H(:, :)
        ${type}$, intent(inout), target, contiguous :: Ebuf(:)
        real(${kind}$), intent(in) :: beta, tau, tol
        logical, intent(in) :: transpose
        integer, intent(out) :: ksteps, kp
        real(${kind}$), intent(out) :: err_est
        logical, intent(out) :: breakdown

        character(len=*), parameter :: this_procedure = 'arnoldi_expm_${type[0]}$${kind}$'
        integer :: k, info

        err_est = huge(1.0_${kind}$) ; breakdown = .false. ; ksteps = 0 ; kp = 1

        do k = 1, size(X) - 1
            call arnoldi(A, X, H, info, kstart=k, kend=k, transpose=transpose)
            call check_info(info, 'arnoldi', this_module, this_procedure)
            ksteps = k
            breakdown = (info == k)

            if (breakdown) then
                ! Invariant subspace: the approximation is exact, drop the extended row.
                kp = k
                call small_expm_${type[0]}$${kind}$(Ebuf, H, kp, kp, tau)
                err_est = 0.0_${kind}$
                return
            endif

            ! Exponential of the (k+1)x(k+1) extended Hessenberg matrix [H_k 0; h e_k^T 0].
            kp = k + 1
            call small_expm_${type[0]}$${kind}$(Ebuf, H, kp, k, tau)

            ! Cheap error estimate (magnitude of the last included correction, conservative).
            err_est = beta*abs(Ebuf(kp))     ! = beta * |E(kp, 1)|
            if (err_est <= tol) return
        enddo
    end subroutine arnoldi_expm_${type[0]}$${kind}$

    subroutine small_expm_${type[0]}$${kind}$(Ebuf, H, n, ncols, tau)
        !! E = exp(tau * Hbar), stored column-major in the contiguous buffer Ebuf(1:n*n). Hbar holds
        !! the first `ncols` columns of H(:n, :) and zeros elsewhere, so stale columns of H (e.g. from
        !! a previous sub-step) are never used. Contiguous storage: stdlib's matrix_exp works in place
        !! without any temporary copy (a section E(:n, :n) of a larger array would be packed at every
        !! call).
        implicit none(type, external)
        ${type}$, intent(inout), target, contiguous :: Ebuf(:)
        ${type}$, intent(in) :: H(:, :)
        integer, intent(in) :: n, ncols
        real(${kind}$), intent(in) :: tau
        ${type}$, pointer, contiguous :: E(:, :)

        E(1:n, 1:n) => Ebuf(1:n*n)
        E(:, :ncols) = tau*H(:n, :ncols)
        if (ncols < n) E(:, ncols+1:n) = zero_${type[0]}$${kind}$
        call matrix_exp(E)
    end subroutine small_expm_${type[0]}$${kind}$

    subroutine project_${type[0]}$${kind}$(c, X, v, alpha)
        !! c = alpha * X @ v, written directly into the output vector (no temporary array).
        !! c is fully overwritten: it is first rebuilt from X(1) with `copy`, so that its previous
        !! state is never read (it may be an intent(out) argument whose components were reset).
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: c
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:)
        ${type}$, intent(in) :: v(:)
        real(${kind}$), optional, intent(in) :: alpha
        real(${kind}$) :: a
        integer :: i
        a = optval(alpha, 1.0_${kind}$)
        call copy(c, X(1))
        call c%scal(a*v(1))
        do i = 2, size(X)
            call c%axpby(a*v(i), X(i), one_${type[0]}$${kind}$)
        enddo
    end subroutine project_${type[0]}$${kind}$

    subroutine project_block_${type[0]}$${kind}$(C, X, V)
        !! C = X @ V for a block of output vectors.
        implicit none(type, external)
        class(abstract_vector_${type[0]}$${kind}$), intent(inout) :: C(:)
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: X(:)
        ${type}$, intent(in) :: V(:, :)
        integer :: j
        do j = 1, size(C)
            call project_${type[0]}$${kind}$(C(j), X, V(:, j))
        enddo
    end subroutine project_block_${type[0]}$${kind}$

    !------------------------------------------
    !-----     Workspace management     -----
    !------------------------------------------

    subroutine ensure_basis_${type[0]}$${kind}$(work, nvec, b)
        !! Makes sure work%X holds at least `nvec` vectors of the same type and size as `b`.
        !! Allocated with `source=b` so that vector types with allocatable components are fully
        !! initialized (with `mold=` their components would be unallocated and their sizes undefined).
        implicit none(type, external)
        type(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: work
        integer, intent(in) :: nvec
        class(abstract_vector_${type[0]}$${kind}$), intent(in) :: b
        character(len=*), parameter :: this_procedure = 'ensure_basis_${type[0]}$${kind}$'
        logical :: ok
        integer :: iostat
        character(len=256) :: msg

        ok = allocated(work%X)
        if (ok) ok = size(work%X) >= nvec
        if (ok) ok = same_type_as(work%X(1), b)
        if (ok) ok = work%X(1)%get_size() == b%get_size()
        if (.not. ok) then
            if (allocated(work%X)) deallocate(work%X)
            allocate(work%X(nvec), source=b, stat=iostat, errmsg=msg)
            call check_allocation(iostat, msg, this_module, this_procedure)
        endif
    end subroutine ensure_basis_${type[0]}$${kind}$

    subroutine ensure_dense_${type[0]}$${kind}$(work, nh)
        !! Makes sure work%H is at least nh x nh and work%Ebuf holds nh*nh entries, then zeroes the
        !! leading nh x nh block of H (entries below the subdiagonal must be zero, and a re-used H
        !! may hold entries from a previous call with another block size).
        implicit none(type, external)
        type(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: work
        integer, intent(in) :: nh
        character(len=*), parameter :: this_procedure = 'ensure_dense_${type[0]}$${kind}$'
        logical :: ok
        integer :: iostat
        character(len=256) :: msg

        ok = allocated(work%H) .and. allocated(work%Ebuf)
        if (ok) ok = size(work%H, 1) >= nh .and. size(work%H, 2) >= nh .and. size(work%Ebuf) >= nh*nh
        if (.not. ok) then
            if (allocated(work%H)) deallocate(work%H)
            if (allocated(work%Ebuf)) deallocate(work%Ebuf)
            allocate(work%H(nh, nh), work%Ebuf(nh*nh), stat=iostat, errmsg=msg)
            call check_allocation(iostat, msg, this_module, this_procedure)
        endif
        work%H(:nh, :nh) = zero_${type[0]}$${kind}$
    end subroutine ensure_dense_${type[0]}$${kind}$

    subroutine free_kexpm_workspace_${type[0]}$${kind}$(self)
        !! Releases the memory held by the workspace.
        implicit none(type, external)
        class(kexpm_workspace_${type[0]}$${kind}$), intent(inout) :: self
        if (allocated(self%X)) deallocate(self%X)
        if (allocated(self%H)) deallocate(self%H)
        if (allocated(self%Ebuf)) deallocate(self%Ebuf)
    end subroutine free_kexpm_workspace_${type[0]}$${kind}$

    #:endfor
    #:for kind in REAL_KINDS
    !------------------------------------------------------------------
    !-----     Metadata of kexpm_substep : learning and printing     -----
    !------------------------------------------------------------------

    subroutine check_substep_inputs_${kind}$(tol, options, info, procedure)
        !! Input checks shared by the sub-stepping drivers: -4 (opts%kdim < 1), -5 (tol < 0),
        !! -7 (opts%max_rejections < 1 or opts%max_substeps < 1); 0 if the inputs are valid.
        implicit none(type, external)
        real(${kind}$), intent(in) :: tol
        class(abstract_opts), optional, intent(in) :: options
        integer, intent(out) :: info
        character(len=*), intent(in) :: procedure
        type(kexpm_${kind}$_opts) :: opts

        opts = kexpm_${kind}$_opts()
        if (present(options)) then
            select type (options)
            type is (kexpm_${kind}$_opts)
                opts = options
            class default
                call type_error('options', 'kexpm_${kind}$_opts', 'IN', this_module, procedure)
            end select
        endif

        info = 0
        if (opts%kdim < 1) then
            info = -4
        else if (tol < 0.0_${kind}$) then
            info = -5
        else if (opts%max_rejections < 1 .or. opts%max_substeps < 1) then
            info = -7
        endif
        if (info /= 0) call log_kexpm_invalid_input(info, procedure)
    end subroutine check_substep_inputs_${kind}$

    subroutine learn_kexpm_${kind}$(self, used_uniform, n_uniform, nsub, mv, fallback, tune, t_end, tol_rel, m)
        !! Updates the learned number of uniform sub-steps after a successful call.
        !!
        !! The cost (matvecs) of N uniform sub-steps increases with N, while too small an N makes
        !! the error check fail (safety net). The cheapest setting is thus the smallest N that does
        !! not need the safety net. The search is:
        !!
        !! - Cold (adaptive) call: record its cost and number of sub-steps `nsub0`; next call
        !!   tries `nsub0 - 1` uniform sub-steps.
        !! - Uniform call, no fallback, cheaper than the best so far: keep it, try one sub-step less.
        !! - Uniform call with fallback, or not cheaper: stop and freeze on the best setting
        !!   (`nsub = 0`, i.e. fully adaptive, if no uniform setting was cheaper).
        !! - Fallback while frozen (e.g. the operator became stiffer): raise the count to
        !!   `max(nsub+1, sub-steps taken by this call)` and, with `tune`, restart the descent.
        implicit none(type, external)
        class(kexpm_${kind}$_metadata), intent(inout) :: self
        logical, intent(in) :: used_uniform, fallback, tune
        integer, intent(in) :: n_uniform, nsub, mv, m
        real(${kind}$), intent(in) :: t_end, tol_rel

        if (.not. self%learned) then
            ! Cold adaptive call.
            self%learned = .true.
            self%tau_learned = t_end ; self%tol_learned = tol_rel ; self%kdim_learned = m
            self%nsub0 = nsub ; self%nsub_best = 0 ; self%mv_best = mv
            if (tune .and. nsub > 1) then
                self%nsub = nsub - 1 ; self%frozen = .false.
            else
                self%nsub = nsub ; self%frozen = .true.
            endif
            return
        endif

        if (.not. used_uniform) return

        if (self%frozen) then
            if (fallback) then
                ! The frozen count became too small: restart the descent from a safe count.
                self%nsub = max(n_uniform + 1, nsub)
                self%nsub_best = 0 ; self%mv_best = huge(1)
                self%frozen = .not. tune
            endif
            return
        endif

        if ((.not. fallback) .and. mv < self%mv_best) then
            self%nsub_best = n_uniform ; self%mv_best = mv
            if (n_uniform > 1) then
                self%nsub = n_uniform - 1
                return
            endif
        endif

        ! Search over: freeze on the best setting (0 = fully adaptive).
        self%frozen = .true. ; self%nsub = self%nsub_best
    end subroutine learn_kexpm_${kind}$

    subroutine print_kexpm_${kind}$(self, reset_counters, verbose)
        implicit none(type, external)
        class(kexpm_${kind}$_metadata), intent(inout) :: self
        logical, optional, intent(in) :: reset_counters
        !! Reset the counters (not the learned settings) after printing?
        logical, optional, intent(in) :: verbose
        !! Also print the internal state of the step-count search?
        character(len=*), parameter :: this_procedure = 'print_kexpm_${kind}$'
        character(len=128) :: msg

        write(msg,'(A,I0,A,I0,A,I0)') 'Calls: ', self%n_calls, ', matvecs: ', self%n_matvec, &
                                    & ', sub-steps: ', self%n_substeps
        call log_message(msg, this_module, this_procedure)
        write(msg,'(A,I0,A,I0)') 'Rejected step sizes: ', self%n_rejections, ', fallbacks: ', self%n_fallbacks
        call log_message(msg, this_module, this_procedure)
        if (self%learned) then
            write(msg,'(A,I0,A,L1,A,I0)') 'Learned uniform sub-steps (0 = adaptive): ', self%nsub, &
                                        & ', frozen: ', self%frozen, ', best cost: ', self%mv_best
        else
            msg = 'No settings learned yet.'
        endif
        call log_message(msg, this_module, this_procedure)
        if (optval(verbose, .false.)) then
            write(msg,'(A,I0,A,I0)') 'Search: nsub0= ', self%nsub0, ', nsub_best= ', self%nsub_best
            call log_message(msg, this_module, this_procedure)
        endif
        if (self%converged) then
            call log_message('Status: CONVERGED', this_module, this_procedure)
        else
            call log_message('Status: NOT CONVERGED', this_module, this_procedure)
        endif
        if (optval(reset_counters, .false.)) call self%reset()
    end subroutine print_kexpm_${kind}$

    subroutine reset_kexpm_${kind}$(self)
        !! Resets the counters. The learned settings are kept (use `forget` to clear them).
        implicit none(type, external)
        class(kexpm_${kind}$_metadata), intent(inout) :: self
        self%n_calls = 0 ; self%n_matvec = 0 ; self%n_substeps = 0
        self%n_rejections = 0 ; self%n_fallbacks = 0
        self%info = 0 ; self%converged = .false.
    end subroutine reset_kexpm_${kind}$

    subroutine forget_kexpm_${kind}$(self)
        !! Clears the learned settings: the next call is a cold, fully adaptive one.
        implicit none(type, external)
        class(kexpm_${kind}$_metadata), intent(inout) :: self
        self%learned = .false. ; self%frozen = .false.
        self%nsub = 0 ; self%nsub_best = 0 ; self%nsub0 = 0 ; self%mv_best = 0
        self%tau_learned = 0.0_${kind}$ ; self%tol_learned = 0.0_${kind}$ ; self%kdim_learned = 0
    end subroutine forget_kexpm_${kind}$

    #:endfor
    !--------------------------------------------
    !-----     Invalid-input diagnostics     -----
    !--------------------------------------------

    subroutine log_kexpm_invalid_input(info, procedure)
        !! Logs the reason for an invalid-input `info` code (the caller returns immediately).
        implicit none(type, external)
        integer, intent(in) :: info
        character(len=*), intent(in) :: procedure
        character(len=128) :: msg
        select case (info)
        case (-3)
            msg = 'Invalid workspace X (fewer than 2*blksize vectors or not a multiple of blksize).'
        case (-4)
            msg = 'Invalid Krylov dimension (kdim < 1).'
        case (-5)
            msg = 'Invalid tolerance (tol < 0).'
        case (-6)
            msg = 'Invalid block size (B is empty or size(C) /= size(B)).'
        case (-7)
            msg = 'Invalid options (max_rejections < 1 or max_substeps < 1).'
        case default
            write(msg, '(A,I0)') 'Invalid input, info = ', info
        end select
        call log_warning(trim(msg), this_module, procedure)
    end subroutine log_kexpm_invalid_input

end module LightKrylov_ExpmLib